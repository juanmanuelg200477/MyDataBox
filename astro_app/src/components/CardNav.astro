---
import '../styles/card-nav.css';

const currentPath = Astro.url.pathname;
let activeBranch = "infra";
if (currentPath.startsWith('/support')) activeBranch = "support";
if (currentPath.startsWith('/servers')) activeBranch = "servers";

// Íconos de las ramas para el panel lateral del teléfono (trazos de Lucide)
const svg = (cuerpo: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${cuerpo}</svg>`;

// short, icon, c1/c2 → solo los usa el panel del teléfono. Los colores son
// los mismos de cada rama en el login (azul, ámbar, morado).
const items = [
  {
    label: "Branch Infrastructure",
    short: "Infrastructure",
    bgColor: "#0D0716",
    textColor: "#fff",
    href: "/login?branch=infra",
    isActive: activeBranch === "infra",
    people: ["Juan Manuel García"],
    c1: "#60a5fa", c2: "#2563eb",
    icon: svg('<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>')
  },
  {
    label: "Branch Support",
    short: "Support",
    bgColor: "#170D27",
    textColor: "#fff",
    href: "/login?branch=support",
    isActive: activeBranch === "support",
    people: ["Adriana González", "Luz Morales"],
    c1: "#fbbf24", c2: "#d97706",
    icon: svg('<path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"/><path d="M21 16v2a4 4 0 0 1-4 4h-5"/>')
  },
  {
    label: "Branch Servers",
    short: "Servers",
    bgColor: "#271E37",
    textColor: "#fff",
    href: "/login?branch=servers",
    isActive: activeBranch === "servers",
    people: ["Bryan Hernández"],
    c1: "#c084fc", c2: "#7e22ce",
    icon: svg('<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>')
  }
];

// Panel del teléfono: la rama actual arriba y, tras la línea de puntos, el resto
const actual = items.find(i => i.isActive);
const otras  = items.filter(i => !i.isActive);
---

<div class="card-nav-container">
  <nav id="card-nav" class="card-nav">
    <div class="card-nav-top">
      <div id="hamburger-menu-cn" class="hamburger-menu-cn" role="button" aria-label="Abrir menú" tabindex="0">
        <div class="hamburger-line-cn"></div>
        <div class="hamburger-line-cn"></div>
      </div>

      <div class="logo-container-cn">
        <svg class="atom-logo-cn" viewBox="0 0 48 48" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="atom-orbit-cn" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#94a3b8" stop-opacity="0.9"/>
                    <stop offset="50%" stop-color="#cbd5e1" stop-opacity="0.7"/>
                    <stop offset="100%" stop-color="#64748b" stop-opacity="0.9"/>
                </linearGradient>
                <radialGradient id="atom-core-cn" cx="50%" cy="40%" r="50%">
                    <stop offset="0%" stop-color="#f1f5f9"/>
                    <stop offset="50%" stop-color="#94a3b8"/>
                    <stop offset="100%" stop-color="#64748b"/>
                </radialGradient>
            </defs>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-cn)" stroke-width="1.4" transform="rotate(0 24 24)"/>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-cn)" stroke-width="1.4" transform="rotate(60 24 24)"/>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-cn)" stroke-width="1.4" transform="rotate(-60 24 24)"/>
            <circle cx="24" cy="24" r="4.5" fill="url(#atom-core-cn)"/>
            <circle cx="24" cy="24" r="3" fill="#cbd5e1" opacity="0.5"/>
        </svg>
        DataBox IT
      </div>
    </div>

    <div id="card-nav-content" class="card-nav-content" aria-hidden="true">
      {items.map((item, idx) => (
        <div
          class={`nav-card nav-card-item ${item.isActive ? 'active-branch' : 'clickable'}`}
          style={`background-color: ${item.bgColor}; color: ${item.textColor}`}
          onclick={!item.isActive ? `window.location.href='${item.href}'` : undefined}
        >
          <div class="nav-card-label">
            {item.label}
          </div>
          <div class="nav-card-links">
            {item.people.map(person => (
              <div class="nav-card-person">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity:0.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                {person}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </nav>
</div>

<!-- ── Teléfono: pestaña lateral con las ramas, al estilo del Edge Panel
     de Samsung. Sustituye al botón azul flotante; en escritorio sigue la
     píldora de arriba y esto no se muestra (ver card-nav.css). ── -->
<div id="edge-root" class="edge-root">
  <div id="edge-scrim" class="edge-scrim"></div>
  <button type="button" id="edge-handle" class="edge-handle"
          aria-label="Abrir el panel de ramas" aria-expanded="false" aria-controls="edge-panel"></button>
  <nav id="edge-panel" class="edge-panel" aria-label="Ramas" inert>
    {actual && (
      <button type="button" class="edge-app is-current" aria-current="page"
              aria-label={`${actual.label} (rama actual)`}
              style={`--i:0;--c1:${actual.c1};--c2:${actual.c2}`}>
        <span class="edge-icon" set:html={actual.icon}></span>
        <span class="edge-label">{actual.short}</span>
      </button>
    )}
    <span class="edge-sep" style="--i:1" aria-hidden="true"></span>
    {otras.map((item, idx) => (
      <a class="edge-app" href={item.href} data-astro-reload
         aria-label={`${item.label}: ${item.people.join(', ')}`}
         style={`--i:${idx + 2};--c1:${item.c1};--c2:${item.c2}`}>
        <span class="edge-icon" set:html={item.icon}></span>
        <span class="edge-label">{item.short}</span>
      </a>
    ))}
  </nav>
</div>

<script>
  // Vanilla JS + GSAP translation for CardNav

  // GSAP se importa del paquete y no del CDN. Antes venía de cdnjs con un
  // <script> en el <head> de todas las páginas: bloqueaba el pintado
  // mientras se descargaba y además duplicaba la copia que MagicBento ya
  // empaqueta. Importándolo aquí, Vite comparte una sola copia entre los
  // dos y la carga sin bloquear.
  import { gsap } from 'gsap';

  // El handler de resize se guarda a nivel de módulo: este script se evalúa
  // una sola vez por documento, pero el callback de abajo corre en CADA
  // navegación. Sin esta referencia, cada navegación dejaba otro listener
  // permanente en window apuntando a nodos y timelines ya desmontados.
  let _resizeHandler = null;

  document.addEventListener('astro:page-load', () => {
    const navContainer = document.querySelector('.card-nav-container');
    const navEl = document.getElementById('card-nav');
    const hamburger = document.getElementById('hamburger-menu-cn');
    const contentEl = document.getElementById('card-nav-content');
    const cards = document.querySelectorAll('.nav-card-item');

    if (!navEl || !hamburger || !contentEl || !navContainer) return;

    let isExpanded = false;
    let tl = null;

    // Solo escritorio: en teléfono la píldora está oculta y las ramas van
    // en la pestaña lateral (ver "Teléfono: pestaña lateral", más abajo).
    const calculateHeight = () => 220; // alto con las tarjetas abiertas

    const createTimeline = () => {
      gsap.set(navEl, { height: 46, overflow: 'hidden' });
      gsap.set(cards, { y: 50, opacity: 0 });

      const timeline = gsap.timeline({ paused: true });

      timeline.to(navEl, {
        height: calculateHeight,
        duration: 0.4,
        ease: 'power3.out'
      });

      timeline.to(cards, { 
          y: 0, 
          opacity: 1, 
          duration: 0.4, 
          ease: 'power3.out', 
          stagger: 0.08 
      }, '-=0.1');

      return timeline;
    };

    tl = createTimeline();

    if (_resizeHandler) window.removeEventListener('resize', _resizeHandler);
    _resizeHandler = () => {
      if (isExpanded) {
        const newHeight = calculateHeight();
        gsap.set(navEl, { height: newHeight });
        tl.kill();
        tl = createTimeline();
        tl.progress(1);
      } else {
        tl.kill();
        tl = createTimeline();
      }
    };
    window.addEventListener('resize', _resizeHandler);

    hamburger.addEventListener('click', () => {
      if (!isExpanded) {
        hamburger.classList.add('open');
        navEl.classList.add('open');
        navContainer.classList.add('open'); // Expand container width
        contentEl.setAttribute('aria-hidden', 'false');
        isExpanded = true;
        tl.play(0);
      } else {
        hamburger.classList.remove('open');
        tl.eventCallback('onReverseComplete', () => {
            navEl.classList.remove('open');
            navContainer.classList.remove('open');
            contentEl.setAttribute('aria-hidden', 'true');
            isExpanded = false;
        });
        tl.reverse();
      }
    });
  });

  // ── Teléfono: pestaña lateral de ramas ──────────────────────
  // Se toca la pestañita del borde izquierdo y el panel sale de lado.
  // Se cierra tocando fuera, deslizándolo hacia la izquierda, con Escape
  // o tocando la rama en la que ya se está.
  //
  // Abrir deslizando desde el borde no se implementa a propósito: en
  // Android con navegación por gestos, ese gesto es "atrás" y el sistema
  // se lo queda antes que la página.

  // Escape se escucha una sola vez por documento (como _resizeHandler) y
  // cierra el panel de la página que esté montada.
  let _cerrarPanelRamas = null;
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') _cerrarPanelRamas?.();
  });

  document.addEventListener('astro:page-load', () => {
    const raiz    = document.getElementById('edge-root');
    const pestana = document.getElementById('edge-handle');
    const fondo   = document.getElementById('edge-scrim');
    const panel   = document.getElementById('edge-panel');
    if (!raiz || !pestana || !fondo || !panel) return;

    const abrir = (e) => {
      raiz.classList.add('open');
      pestana.setAttribute('aria-expanded', 'true');
      panel.inert = false;
      // Con teclado (detail 0) el foco entra al panel; con el dedo no,
      // para que no aparezca un anillo de foco sin motivo.
      if (e?.detail === 0) panel.querySelector('.edge-app')?.focus();
    };
    const cerrar = () => {
      if (!raiz.classList.contains('open')) return;
      const teniaFoco = panel.contains(document.activeElement);
      raiz.classList.remove('open');
      pestana.setAttribute('aria-expanded', 'false');
      panel.inert = true;
      if (teniaFoco) pestana.focus();
    };
    _cerrarPanelRamas = cerrar;

    pestana.addEventListener('click', abrir);
    fondo.addEventListener('click', cerrar);
    panel.querySelector('.is-current')?.addEventListener('click', cerrar);

    // Deslizar el panel hacia la izquierda lo guarda. Mientras el dedo
    // arrastra, el panel lo sigue; al soltar, o se va o vuelve a su sitio.
    let x0 = null;
    let dx = 0;
    panel.addEventListener('touchstart', (e) => {
      x0 = e.touches[0].clientX;
      dx = 0;
      panel.style.transition = 'none';
    }, { passive: true });
    panel.addEventListener('touchmove', (e) => {
      if (x0 === null) return;
      dx = Math.min(0, e.touches[0].clientX - x0);
      panel.style.transform = `translate(${dx}px, -50%)`;
    }, { passive: true });
    const soltar = () => {
      if (x0 === null) return;
      x0 = null;
      // Quitar los estilos en línea en la misma tarea en que se cierra:
      // la transición arranca desde donde quedó el dedo.
      panel.style.transition = '';
      panel.style.transform = '';
      if (dx < -40) cerrar();
    };
    panel.addEventListener('touchend', soltar);
    panel.addEventListener('touchcancel', soltar);
  });
</script>
