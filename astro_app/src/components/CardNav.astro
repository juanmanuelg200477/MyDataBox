---
import '../styles/card-nav.css';

const currentPath = Astro.url.pathname;
let activeBranch = "infra";
if (currentPath.startsWith('/support')) activeBranch = "support";
if (currentPath.startsWith('/servers')) activeBranch = "servers";

const items = [
  {
    label: "Branch Infrastructure",
    bgColor: "#0D0716",
    textColor: "#fff",
    onClick: "window.location.href='/login?branch=infra'",
    isActive: activeBranch === "infra",
    people: ["Juan Manuel García"]
  },
  {
    label: "Branch Support", 
    bgColor: "#170D27",
    textColor: "#fff",
    onClick: "window.location.href='/login?branch=support'",
    isActive: activeBranch === "support",
    people: ["Adriana González", "Luz Morales"]
  },
  {
    label: "Branch Servers",
    bgColor: "#271E37", 
    textColor: "#fff",
    onClick: "window.location.href='/login?branch=servers'",
    isActive: activeBranch === "servers",
    people: ["Bryan Hernández"]
  }
];
---

<div class="card-nav-container">
  <nav id="card-nav" class="card-nav">
    <div class="card-nav-top">
      <div id="hamburger-menu-cn" class="hamburger-menu-cn" role="button" aria-label="Abrir menú" tabindex="0">
        <div class="hamburger-line-cn"></div>
        <div class="hamburger-line-cn"></div>
      </div>

      <div class="logo-container-cn">
        <svg class="atom-logo-cn" viewBox="0 0 48 48" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="atom-orbit-cn" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#94a3b8" stop-opacity="0.9"/>
                    <stop offset="50%" stop-color="#cbd5e1" stop-opacity="0.7"/>
                    <stop offset="100%" stop-color="#64748b" stop-opacity="0.9"/>
                </linearGradient>
                <radialGradient id="atom-core-cn" cx="50%" cy="40%" r="50%">
                    <stop offset="0%" stop-color="#f1f5f9"/>
                    <stop offset="50%" stop-color="#94a3b8"/>
                    <stop offset="100%" stop-color="#64748b"/>
                </radialGradient>
            </defs>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-cn)" stroke-width="1.4" transform="rotate(0 24 24)"/>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-cn)" stroke-width="1.4" transform="rotate(60 24 24)"/>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-cn)" stroke-width="1.4" transform="rotate(-60 24 24)"/>
            <circle cx="24" cy="24" r="4.5" fill="url(#atom-core-cn)"/>
            <circle cx="24" cy="24" r="3" fill="#cbd5e1" opacity="0.5"/>
        </svg>
        DataBox IT
      </div>
    </div>

    <div id="card-nav-content" class="card-nav-content" aria-hidden="true">
      {items.map((item, idx) => (
        <div
          class={`nav-card nav-card-item ${item.isActive ? 'active-branch' : 'clickable'}`}
          style={`background-color: ${item.bgColor}; color: ${item.textColor}`}
          onclick={!item.isActive ? item.onClick : undefined}
        >
          <div class="nav-card-label">
            {item.label}
          </div>
          <div class="nav-card-links">
            {item.people.map(person => (
              <div class="nav-card-person">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity:0.6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                {person}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </nav>
</div>

<script>
  // Vanilla JS + GSAP translation for CardNav

  // GSAP se importa del paquete y no del CDN. Antes venía de cdnjs con un
  // <script> en el <head> de todas las páginas: bloqueaba el pintado
  // mientras se descargaba y además duplicaba la copia que MagicBento ya
  // empaqueta. Importándolo aquí, Vite comparte una sola copia entre los
  // dos y la carga sin bloquear.
  import { gsap } from 'gsap';

  // El handler de resize se guarda a nivel de módulo: este script se evalúa
  // una sola vez por documento, pero el callback de abajo corre en CADA
  // navegación. Sin esta referencia, cada navegación dejaba otro listener
  // permanente en window apuntando a nodos y timelines ya desmontados.
  let _resizeHandler = null;

  document.addEventListener('astro:page-load', () => {
    const navContainer = document.querySelector('.card-nav-container');
    const navEl = document.getElementById('card-nav');
    const hamburger = document.getElementById('hamburger-menu-cn');
    const contentEl = document.getElementById('card-nav-content');
    const cards = document.querySelectorAll('.nav-card-item');

    if (!navEl || !hamburger || !contentEl || !navContainer) return;

    let isExpanded = false;
    let tl = null;

    const calculateHeight = () => {
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      if (isMobile) {
        const wasVisible = contentEl.style.visibility;
        const wasPosition = contentEl.style.position;
        const wasHeight = contentEl.style.height;

        contentEl.style.visibility = 'visible';
        contentEl.style.position = 'static';
        contentEl.style.height = 'auto';
        contentEl.style.width = '240px'; // Simular ancho expandido para medición exacta
        contentEl.offsetHeight; // force reflow

        const baseHeight = 60; // Mobile FAB height
        const padding = 12;
        const contentHeight = contentEl.scrollHeight;

        contentEl.style.visibility = wasVisible;
        contentEl.style.position = wasPosition;
        contentEl.style.height = wasHeight;
        contentEl.style.width = ''; // Limpiar wrap forzado

        return baseHeight + contentHeight + padding;
      }
      return 220; // Default height for desktop cards
    };

    const createTimeline = () => {
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      const baseHeight = isMobile ? 60 : 46;
      
      gsap.set(navEl, { height: baseHeight, overflow: 'hidden' });
      // Si es móvil, expanden desde abajo hacia arriba (y positivos significa empujar hacia abajo, entonces al invertir crecen de arriba hacia abajo. Oh wait, GSAP "from" means start offset.)
      gsap.set(cards, { y: isMobile ? 15 : 50, opacity: 0 });

      const timeline = gsap.timeline({ paused: true });

      timeline.to(navEl, {
        height: calculateHeight,
        duration: 0.4,
        ease: 'power3.out'
      });

      timeline.to(cards, { 
          y: 0, 
          opacity: 1, 
          duration: 0.4, 
          ease: 'power3.out', 
          stagger: 0.08 
      }, '-=0.1');

      return timeline;
    };

    tl = createTimeline();

    if (_resizeHandler) window.removeEventListener('resize', _resizeHandler);
    _resizeHandler = () => {
      if (isExpanded) {
        const newHeight = calculateHeight();
        gsap.set(navEl, { height: newHeight });
        tl.kill();
        tl = createTimeline();
        tl.progress(1);
      } else {
        tl.kill();
        tl = createTimeline();
      }
    };
    window.addEventListener('resize', _resizeHandler);

    hamburger.addEventListener('click', () => {
      if (!isExpanded) {
        hamburger.classList.add('open');
        navEl.classList.add('open');
        navContainer.classList.add('open'); // Expand container width
        contentEl.setAttribute('aria-hidden', 'false');
        isExpanded = true;
        tl.play(0);
      } else {
        hamburger.classList.remove('open');
        tl.eventCallback('onReverseComplete', () => {
            navEl.classList.remove('open');
            navContainer.classList.remove('open');
            contentEl.setAttribute('aria-hidden', 'true');
            isExpanded = false;
        });
        tl.reverse();
      }
    });
  });
</script>
