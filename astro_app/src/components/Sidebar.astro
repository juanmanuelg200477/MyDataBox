---
const currentPath = Astro.url.pathname;

const menuLinks = [
    { name: 'Dashboard', path: '/', view: 'dashboard', icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>' },
    { name: 'Regiones', path: '/regiones', view: 'regions', icon: '<circle cx="12" cy="10" r="3"/><path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"/>' },
    { name: 'Áreas', path: '/areas', view: 'areas', icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="12" y1="3" x2="12" y2="21"/>' },
];

const contactLinks = [
    { name: 'Contactos', path: '/contactos', view: 'contacts', icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' }
];

const notesLinks = [
    { name: 'WorkSpace', path: '/notas', view: 'notes', icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/>' }
];

const auditLinks = [
    { name: 'Actividad', path: '/actividad', view: 'activity', icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' }
];

const infraLinks = [
    { name: 'Bastidores', path: '/bastidores', view: 'racks', icon: '<rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="16" y2="18"/>' },
    { name: 'Dispositivos', path: '/dispositivos', view: 'devices', icon: '<rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/><circle cx="18" cy="7" r="1"/><circle cx="18" cy="14" r="1"/>' }
];

function isActive(path: string) {
    if (path === '/' && currentPath === '/') return true;
    if (path !== '/' && currentPath.startsWith(path)) return true;
    return false;
}

let activeBranch = "Infrastructure";
let isMainArea = true;

if (currentPath.startsWith('/support')) {
    activeBranch = "Support";
    isMainArea = false;
} else if (currentPath.startsWith('/servers')) {
    activeBranch = "Servers";
    isMainArea = false;
}
---

<nav class="sidebar">
    <div class="sidebar-brand">
        <svg class="atom-logo" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="atom-orbit-sb" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#c0c0c0" stop-opacity="0.9"/>
                    <stop offset="50%" stop-color="#e8e8e8" stop-opacity="0.7"/>
                    <stop offset="100%" stop-color="#a0a0a0" stop-opacity="0.9"/>
                </linearGradient>
                <radialGradient id="atom-core-sb" cx="50%" cy="40%" r="50%">
                    <stop offset="0%" stop-color="#ffffff"/>
                    <stop offset="50%" stop-color="#d4d4d8"/>
                    <stop offset="100%" stop-color="#a1a1aa"/>
                </radialGradient>
            </defs>
            <!-- Orbits -->
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-sb)" stroke-width="1.2" transform="rotate(0 24 24)" class="atom-orbit-ring"/>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-sb)" stroke-width="1.2" transform="rotate(60 24 24)" class="atom-orbit-ring"/>
            <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-sb)" stroke-width="1.2" transform="rotate(-60 24 24)" class="atom-orbit-ring"/>
            <!-- Nucleus -->
            <circle cx="24" cy="24" r="4.5" fill="url(#atom-core-sb)"/>
            <circle cx="24" cy="24" r="3" fill="#e4e4e7" opacity="0.6"/>
        </svg>
        <div><span>DataBox IT</span><small>{activeBranch}</small></div>
    </div>

    {isMainArea && (
        <>
            <div class="sidebar-section">Organización</div>
            {menuLinks.map(link => (
                <a href={link.path} class={`sidebar-item ${isActive(link.path) ? 'active' : ''}`} data-astro-prefetch>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={link.icon}></svg>
                    {link.name}
                </a>
            ))}

            <div class="sidebar-section">Contactos</div>
            {contactLinks.map(link => (
                <a href={link.path} class={`sidebar-item ${isActive(link.path) ? 'active' : ''}`} data-astro-prefetch>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={link.icon}></svg>
                    {link.name}
                </a>
            ))}

            <div class="sidebar-section">WorkSpace</div>
            {notesLinks.map(link => (
                <a href={link.path} class={`sidebar-item ${isActive(link.path) ? 'active' : ''}`} data-astro-prefetch>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={link.icon}></svg>
                    {link.name}
                </a>
            ))}

            <div class="sidebar-section">Auditoría</div>
            {auditLinks.map(link => (
                <a href={link.path} class={`sidebar-item ${isActive(link.path) ? 'active' : ''}`} data-astro-prefetch>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={link.icon}></svg>
                    {link.name}
                </a>
            ))}

            <div class="sidebar-section">Infraestructura</div>
            {infraLinks.map(link => (
                <a href={link.path} class={`sidebar-item ${isActive(link.path) ? 'active' : ''}`} data-astro-prefetch>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={link.icon}></svg>
                    {link.name}
                </a>
            ))}
        </>
    )}

    <div class="sidebar-footer">
        <div class="sidebar-footer-user">
            <div class="sidebar-footer-avatar">JM</div>
            <div class="sidebar-footer-info">
                <div>Admin</div>
                <div>DataBox IT</div>
            </div>
        </div>
    </div>
</nav>

<style>
/* Reset sidebar item specifically since a tags are inline */
.sidebar-item {
    text-decoration: none;
}

/* Atom logo in sidebar */
.atom-logo {
    width: 36px;
    height: 36px;
    animation: atomSpin 12s linear infinite;
    filter: drop-shadow(0 0 4px rgba(148, 163, 184, 0.3));
}
@keyframes atomSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}
.atom-logo:hover {
    filter: drop-shadow(0 0 8px rgba(203, 213, 225, 0.6));
}
</style>
