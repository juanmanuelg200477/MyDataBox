---
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import CardNav from '../components/CardNav.astro';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Gestión de Infraestructura Databox" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} — DataBox IT</title>
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
		<ClientRouter />
		<script is:inline>
			// Bloqueo síncrono ultra-rápido para prevenir flash de UI
			(() => {
				let hasToken = false;
				try {
					for(let i=0; i<localStorage.length; i++) {
						if(localStorage.key(i).endsWith('auth-token')) { hasToken = true; break; }
					}
				} catch(e) {}
				if(!hasToken && !window.location.pathname.includes('/login')) {
					window.location.replace('/login');
				}
			})();
		</script>
	</head>
	<body>
		<!-- Page Loading Overlay: Actúa como transición entre páginas -->
		<script is:inline>
			// Se activa inmediatamente para enmascarar transiciones
			document.documentElement.classList.add('page-loading');
			// Aplicar viewer-mode SINCRÓNICAMENTE en <html> para que el CSS
			// oculte botones de edición antes de que se renderice nada.
			if (sessionStorage.getItem('databox_role') === 'viewer') {
				document.documentElement.classList.add('viewer-mode');
			}
		</script>
		<style is:global>
			#page-loading-overlay { display: none; }
			html.page-loading #page-loading-overlay { display: flex !important; }
			html.page-loading body { overflow: hidden; }
		</style>
		<div id="page-loading-overlay" style="position:fixed;inset:0;background:#0D0716;z-index:999999;flex-direction:column;gap:24px;align-items:center;justify-content:center;transition:opacity 0.3s ease, visibility 0.3s ease;">
			<div style="position:relative;width:64px;height:64px;display:flex;align-items:center;justify-content:center;">
				<div style="position:absolute;width:100%;height:100%;border-radius:50%;border:2px solid transparent;border-top-color:#3b82f6;border-left-color:rgba(59,130,246,0.3);animation:a-orb 1.2s linear infinite;"></div>
				<div style="position:absolute;width:100%;height:100%;border-radius:50%;border:2px solid transparent;border-top-color:#14b8a6;border-left-color:rgba(20,184,166,0.3);animation:a-orb2 1.4s linear infinite;"></div>
				<div style="position:absolute;width:100%;height:100%;border-radius:50%;border:2px solid transparent;border-top-color:#8b5cf6;border-left-color:rgba(139,92,246,0.3);animation:a-orb3 1.6s linear infinite;"></div>
				<div style="width:12px;height:12px;background:#3b82f6;border-radius:50%;box-shadow:0 0 15px #3b82f6;animation:a-pulse 1.5s ease-in-out infinite;"></div>
			</div>
			<div style="color:rgba(255,255,255,0.7);font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;animation:txt-pulse 1.5s ease-in-out infinite;">Un momento...</div>
			<style>
				@keyframes a-orb { 0% { transform: rotateZ(0deg) rotateX(66deg) rotateZ(0deg); } 100% { transform: rotateZ(0deg) rotateX(66deg) rotateZ(360deg); } }
				@keyframes a-orb2 { 0% { transform: rotateZ(60deg) rotateX(66deg) rotateZ(0deg); } 100% { transform: rotateZ(60deg) rotateX(66deg) rotateZ(360deg); } }
				@keyframes a-orb3 { 0% { transform: rotateZ(120deg) rotateX(66deg) rotateZ(0deg); } 100% { transform: rotateZ(120deg) rotateX(66deg) rotateZ(360deg); } }
				@keyframes a-pulse { 0%,100%{transform:scale(1);opacity:1;} 50%{transform:scale(0.85);opacity:0.75;} }
				@keyframes txt-pulse { 0%,100%{opacity:0.4;} 50%{opacity:0.9;} }
			</style>
		</div>
		<div class="sidebar-overlay" id="sidebar-overlay"></div>
		<Sidebar />
		<CardNav />
		
		<div class="main">
			<div class="topbar">
				<button id="hamburger-btn" class="hamburger-btn" aria-label="Abrir menú">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="3" y1="12" x2="21" y2="12"></line>
						<line x1="3" y1="6" x2="21" y2="6"></line>
						<line x1="3" y1="18" x2="21" y2="18"></line>
					</svg>
				</button>
				<div class="breadcrumb" id="breadcrumb">
					<span>DataBox IT</span>
					<span class="sep">›</span>
					<span class="current">{title}</span>
				</div>
				<button id="btn-logout" title="Cerrar sesión" style="margin-left:auto;background:none;border:1px solid var(--border);border-radius:8px;padding:6px 10px;cursor:pointer;color:var(--text-muted);display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;font-family:inherit;transition:all 0.2s;flex-shrink:0;">
					<svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
						<polyline points="16 17 21 12 16 7"/>
						<line x1="21" y1="12" x2="9" y2="12"/>
					</svg>
					Salir
				</button>
			</div>
			<div class="content" id="app">
				<slot />
			</div>
		</div>

		<!-- Global Modal Component will be injected here by scripts -->
		
		<script>
			import { supabase } from '../scripts/supabase.js';

				// ── Detectar token de recovery en el hash ─────────
			// Cuando Supabase redirige tras "Reset Password", pone
			// #access_token=...&type=recovery en la URL. Lo capturamos
			// aquí y mandamos al usuario a la página de nueva contraseña.
			(async () => {
				const hash = window.location.hash;
				if (hash && hash.includes('type=recovery')) {
					window.location.href = '/reset-password' + hash;
					return;
				}
			})();

			// ── Hook de Navegación ─────────────────────────────
			// Dispara el overlay inmediatamente antes de buscar la nueva página
			document.addEventListener('astro:before-preparation', () => {
				document.documentElement.classList.add('page-loading');
				const overlay = document.getElementById('page-loading-overlay');
				if (overlay) {
					overlay.style.transition = 'none';
					overlay.style.opacity = '1';
					overlay.style.pointerEvents = 'all';
				}
			});

			// ── Guard de sesión y Fin de Carga ──────────────────
			// Corre en cada navegación (incluidas view transitions).
			// Si no hay sesión activa redirige al login.
			document.addEventListener('astro:page-load', async () => {
				// ── Rol: aplicar SINCRÓNICAMENTE antes del await ──
				// Garantiza que viewer-mode esté en el body antes de que
				// cualquier módulo renderice sus botones de acción.
				const cachedRole = sessionStorage.getItem('databox_role');
				if (cachedRole === 'viewer') {
					document.body.classList.add('viewer-mode');
				}

				const { data: { session } } = await supabase.auth.getSession();
				
				if (!session) {
					window.location.href = '/login';
					return;
				}

				// Sesión validada e inicialización lista: Retirar overlay global
				const loadingOverlay = document.getElementById('page-loading-overlay');
				if (loadingOverlay) {
					loadingOverlay.style.transition = 'opacity 0.3s ease';
					loadingOverlay.style.pointerEvents = 'none';
					loadingOverlay.style.opacity = '0';
					setTimeout(() => { 
						document.documentElement.classList.remove('page-loading');
					}, 300);
				}

				// ── Rol: refrescar desde sesión activa ─────────
				const role = session.user?.user_metadata?.role ?? 'admin';
				sessionStorage.setItem('databox_role', role);
				if (role === 'viewer') {
					document.body.classList.add('viewer-mode');
				} else {
					document.body.classList.remove('viewer-mode');
				}

				// Animación de bienvenida especial (para ambos roles)
				const welcomeKey = role === 'viewer' ? 'viewer_welcomed' : 'admin_welcomed';
				if (!sessionStorage.getItem(welcomeKey)) {
					sessionStorage.setItem(welcomeKey, 'true');
					const subText = role === 'viewer' ? 'Solo Lectura' : 'Modo Administrador';
					const subColor = role === 'viewer' ? '#f59e0b' : '#10b981'; // Ambar para viewer, Esmeralda para admin
					const shadowColor = role === 'viewer' ? 'rgba(245,158,11,0.5)' : 'rgba(16,185,129,0.5)';

					const vw = document.createElement('div');
					vw.id = 'role-welcome-overlay';
					vw.innerHTML = `
						<style>
							#role-welcome-overlay {
								position: fixed; inset: 0; background: #0D0716; z-index: 9999999;
								display: flex; flex-direction: column; align-items: center; justify-content: center;
								opacity: 1; transition: opacity 0.8s ease;
							}
							.vw-atom {
								position: relative; width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; margin-bottom: 35px;
							}
							.vw-orb {
								position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 4px solid transparent;
								mix-blend-mode: screen; filter: drop-shadow(0 0 15px currentColor);
							}
							.vw-orb-1 { border-top-color: #3b82f6; border-left-color: rgba(59,130,246,0.6); color: #3b82f6; animation: vw-spin1 1.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite; }
							.vw-orb-2 { border-top-color: #14b8a6; border-left-color: rgba(20,184,166,0.6); color: #14b8a6; animation: vw-spin2 1.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite; }
							.vw-orb-3 { border-top-color: #f59e0b; border-left-color: rgba(245,158,11,0.6); color: #f59e0b; animation: vw-spin3 1.4s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite; }
							.vw-core {
								width: 30px; height: 30px; background: #fff; border-radius: 50%;
								box-shadow: 0 0 35px 12px rgba(255,255,255,1), 0 0 70px 25px #3b82f6;
								animation: vw-pulse 1s ease-in-out infinite alternate;
							}
							.vw-text-title {
								color: #ffffff; font-size: 32px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase;
								text-shadow: 0 0 25px rgba(255,255,255,0.5); animation: vw-fadein 1s ease forwards;
							}
							.vw-text-sub {
								color: ${subText === 'Solo Lectura' ? '#f59e0b' : '#10b981'}; font-size: 15px; font-weight: 700; letter-spacing: 5px; text-transform: uppercase; 
								margin-top: 10px; animation: vw-fadein 1.5s ease forwards; text-shadow: 0 0 15px ${subText === 'Solo Lectura' ? 'rgba(245,158,11,0.5)' : 'rgba(16,185,129,0.5)'};
							}
							@keyframes vw-spin1 { 0% { transform: rotateZ(0deg) rotateX(70deg) rotateZ(0deg); } 100% { transform: rotateZ(360deg) rotateX(70deg) rotateZ(360deg); } }
							@keyframes vw-spin2 { 0% { transform: rotateZ(120deg) rotateX(70deg) rotateZ(0deg); } 100% { transform: rotateZ(480deg) rotateX(70deg) rotateZ(360deg); } }
							@keyframes vw-spin3 { 0% { transform: rotateZ(240deg) rotateX(70deg) rotateZ(0deg); } 100% { transform: rotateZ(600deg) rotateX(70deg) rotateZ(360deg); } }
							@keyframes vw-pulse { 0% { transform: scale(0.85); box-shadow: 0 0 30px 10px rgba(255,255,255,0.8), 0 0 50px 15px #3b82f6; } 100% { transform: scale(1.3); box-shadow: 0 0 45px 15px rgba(255,255,255,1), 0 0 80px 30px #14b8a6; } }
							@keyframes vw-fadein { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
						</style>
						<div class="vw-atom">
							<div class="vw-orb vw-orb-1"></div>
							<div class="vw-orb vw-orb-2"></div>
							<div class="vw-orb vw-orb-3"></div>
							<div class="vw-core"></div>
						</div>
						<div class="vw-text-title">Bienvenido</div>
						<div class="vw-text-sub">${subText}</div>
					`;
					document.body.appendChild(vw);
					setTimeout(() => {
						vw.style.opacity = '0';
						setTimeout(() => vw.remove(), 800);
					}, 3600); // Muestra la animación por 3.6 segundos
				}

				// ── Sidebar Hamburguesa ────────────────────────
				const btn     = document.getElementById('hamburger-btn');
				const sidebar = document.querySelector('.sidebar');
				const overlay = document.getElementById('sidebar-overlay');
				if (btn && sidebar && overlay) {
					// Reset estado del sidebar en cada navegación para evitar
					// que el overlay quede activo entre view transitions
					sidebar.classList.remove('open');
					overlay.classList.remove('active');

					const toggleMenu = () => {
						sidebar.classList.toggle('open');
						overlay.classList.toggle('active');
					};
					btn.onclick     = toggleMenu;
					overlay.onclick = toggleMenu;
				}

				// ── Logout ─────────────────────────────────────
				const logoutBtn = document.getElementById('btn-logout');
				if (logoutBtn) {
					logoutBtn.onclick = async () => {
						await supabase.auth.signOut();
						sessionStorage.removeItem('auth_cleared');
						sessionStorage.removeItem('databox_role');
						sessionStorage.removeItem('viewer_welcomed');
						sessionStorage.removeItem('admin_welcomed');
						window.location.href = '/login';
					};
				}
			});
		</script>
	</body>
</html>
