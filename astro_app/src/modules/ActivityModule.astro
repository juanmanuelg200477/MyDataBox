---
import { icons } from '../scripts/icons.js';
---
<div class="view-transition" id="activity-module">
    <div class="page-header">
        <div>
            <h1>Actividad</h1>
            <p style="font-size:13px;color:var(--text-muted);margin-top:4px;">
                Quién cambió qué y cuándo. El historial es inmutable: no se puede editar ni borrar.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-header" style="flex-wrap:wrap;row-gap:10px;">
            <h2>Registro <span id="activity-status" style="font-weight:500;font-size:12px;color:var(--text-muted);margin-left:8px"></span></h2>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <select id="activity-entity-filter" class="dev-filter-select">
                    <option value="">Todos los tipos</option>
                </select>
                <select id="activity-action-filter" class="dev-filter-select">
                    <option value="">Cualquier acción</option>
                    <option value="insert">Creó</option>
                    <option value="update">Modificó</option>
                    <option value="delete">Eliminó</option>
                </select>
            </div>
        </div>

        <div class="db-loading" id="activity-loading">
            <div class="db-spinner"></div>
            <span>Cargando actividad…</span>
        </div>

        <div id="activity-table-container" style="display:none">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th><th>Usuario</th><th>Acción</th>
                        <th>Tipo</th><th>Elemento</th><th>Cambios</th>
                    </tr>
                </thead>
                <tbody id="activity-tbody"></tbody>
            </table>
            <div style="padding:14px;text-align:center;border-top:1px solid var(--border)">
                <button class="btn btn-outline" id="activity-more" style="display:none">Cargar más</button>
            </div>
        </div>

        <div id="activity-empty-state" class="empty-state" style="display:none">
            <div set:html={icons.save}></div>
            <p>Sin actividad registrada</p>
            <small>Los cambios que hagas en el inventario aparecerán aquí.</small>
        </div>
    </div>
</div>

<style>
/* Reutiliza el estilo de filtros de Bastidores/Dispositivos */
.dev-filter-select {
    padding: 8px 11px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    font-size: 12.5px;
    font-family: inherit;
    background: var(--bg);
    color: var(--text);
    transition: var(--transition);
    cursor: pointer;
}
.dev-filter-select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-light);
}

:global(.ac-details) { font-size: 12px; }
:global(.ac-details summary) {
    cursor: pointer;
    color: var(--primary);
    font-weight: 600;
    font-size: 11.5px;
}
:global(.ac-changes) {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 5px;
}
:global(.ac-change) {
    display: grid;
    grid-template-columns: minmax(70px, auto) 1fr auto 1fr;
    gap: 8px;
    align-items: baseline;
    font-size: 11.5px;
}
:global(.ac-change-field) { font-weight: 700; color: var(--text); }
:global(.ac-change-before) {
    color: var(--text-muted);
    text-decoration: line-through;
    overflow-wrap: anywhere;
}
:global(.ac-change-arrow) { color: var(--text-muted); }
:global(.ac-change-after) { color: var(--text); overflow-wrap: anywhere; }
</style>

<script>
    import { initActivity } from '../scripts/views/activity.js';
    document.addEventListener('astro:page-load', () => {
        // Guard de ruta: el listener vive en document y se dispara en TODA
        // navegación posterior.
        if (window.location.pathname.replace(/\/$/, '') !== '/actividad') return;
        // Esta vista no usa el store del inventario: lee audit_log directo.
        document.getElementById('activity-loading')?.remove();
        initActivity();
    });
</script>
