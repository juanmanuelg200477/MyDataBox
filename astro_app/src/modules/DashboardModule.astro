}

/* ── Clickable card hint ────────────────────────────── */
.db-card[data-preview] { cursor: pointer; }
.db-card[data-preview]:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}
.db-expand-hint {
  font-size: 10px;
