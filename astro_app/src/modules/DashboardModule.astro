<script>
  import { load, exportSnapshot } from '../scripts/store.js';
  import { initDashboard } from '../scripts/views/dashboard.js';
  import { openCardPreview } from '../scripts/views/dashboardPreview.js';
  import { downloadJson } from '../scripts/utils.js';
  import { toastSuccess } from '../scripts/toast.js';
  document.addEventListener('astro:page-load', async () => {
    if (window.location.pathname !== '/' && window.location.pathname !== '/index') return;
    await load();
    initDashboard();

    // ── Respaldo del inventario ───────────────────────────
    const backupBtn = document.getElementById('db-backup');
    if (backupBtn) {
      backupBtn.onclick = () => {
        const stamp = new Date().toISOString().slice(0, 10);
        downloadJson(`databox-respaldo-${stamp}.json`, exportSnapshot());
        toastSuccess('Respaldo descargado. Contiene credenciales de ISP en texto plano: guárdalo en un sitio seguro.', {
          title: 'Respaldo generado'
        });
      };
    }

    // ── Cursor spotlight on cards ─────────────────────────
    document.querySelectorAll('.db-card').forEach(card => {
      card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--sx', `${x}px`);
        card.style.setProperty('--sy', `${y}px`);
      });
    });

    // ── Click → preview modal ─────────────────────────────
    document.querySelectorAll('.db-card[data-preview]').forEach(card => {
      const key = card.dataset.preview;
      const open = () => openCardPreview(key);
      card.addEventListener('click', e => {
        // Evita abrir si se hizo click en un enlace o botón interno
        if (e.target.closest('a, button, .dbc-rack-name, .dbc-act-row')) return;
        open();
      });
      card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
    });

    // ── Staggered entrance for scrollable rows ────────────
    const animateRows = (selector) => {
      document.querySelectorAll(selector).forEach((row, i) => {
        row.classList.add('db-anim-row');
        row.style.animationDelay = `${i * 55}ms`;
      });
    };
    // Small delay to let JS inject the HTML first
    setTimeout(() => {
      animateRows('.dbc-rack-row');
      animateRows('.dbc-cat-row');
      animateRows('.dbc-isp-row');
      animateRows('.dbc-act-row');
      animateRows('.dbc-inc-item');
    }, 100);
  });
</script>
