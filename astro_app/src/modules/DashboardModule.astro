---
import { icons } from '../scripts/icons.js';
import TechText from '../components/TechText.jsx';
---

<div class="db" id="db-wrap">

  <!-- ══ HEADER ════════════════════════════════════════════ -->
  <header class="db-header">
    <div class="db-header-glow"></div>
    <div class="db-header-grid"></div>
    <!-- Destello lento que recorre la barra: el único movimiento que
         queda aquí, y es decorativo. -->
    <div class="db-header-sheen"></div>

    <div class="db-brand">
      <!-- El nombre se dibuja con TechText. El propio componente expone
           el texto como aria-label, así que no hace falta duplicarlo. -->
      <div class="db-brand-canvas">
        <TechText
          client:only="react"
          text="DataBox IT"
          align="left"
          fontSize={44}
          fontWeight={800}
          letterSpacing={-0.03}
          color="#ffffff"
          accentColor="#93c5fd"
          reach={110}
          specks={12}
          strokeWidth={1.2}
          labels={false}
        />
      </div>
      <div class="db-brand-sub">Centro de Control · Infraestructura de Red</div>
    </div>

    <div class="db-sep"></div>

    <div class="db-kv-row">
      <div class="db-kv" style="--kc:#60a5fa"><span class="db-kv-n" id="stat-regions">0</span><span class="db-kv-l">Regiones</span></div>
      <div class="db-kv" style="--kc:#34d399"><span class="db-kv-n" id="stat-areas">0</span><span class="db-kv-l">Áreas</span></div>
      <div class="db-kv" style="--kc:#a78bfa"><span class="db-kv-n" id="stat-racks">0</span><span class="db-kv-l">Bastidores</span></div>
      <div class="db-kv" style="--kc:#4ade80"><span class="db-kv-n" id="stat-devices">0</span><span class="db-kv-l">Dispositivos</span></div>
      <div class="db-kv" style="--kc:#fb923c"><span class="db-kv-n" id="stat-contacts">0</span><span class="db-kv-l">Contactos</span></div>
      <div class="db-kv" style="--kc:#22d3ee"><span class="db-kv-n" id="stat-isps">0</span><span class="db-kv-l">ISPs</span></div>
    </div>
  </header>

  <!-- ══ ROW 1 ══════════════════════════════════════════════ -->
  <div class="db-row db-row-1">

    <!-- Estado del Inventario — donut -->
    <div class="db-card" style="--accent:#10b981" data-preview="status" tabindex="0" role="button" aria-label="Ver detalle de Estado del Inventario">
      <div class="db-card-hdr">
        <div><div class="db-card-title">Estado del Inventario</div><div class="db-card-sub">Distribución por estado</div></div>
        <span class="db-expand-hint" aria-hidden="true">Ver detalle ↗</span>
      </div>
      <div id="chart-status" class="db-chart-host"></div>
    </div>

    <!-- Regiones — donut -->
    <div class="db-card" style="--accent:#3b82f6" data-preview="regions" tabindex="0" role="button" aria-label="Ver detalle de Distribución Regional">
      <div class="db-card-hdr">
        <div><div class="db-card-title">Distribución Regional</div><div class="db-card-sub">Dispositivos por región</div></div>
        <span class="db-expand-hint" aria-hidden="true">Ver detalle ↗</span>
      </div>
      <div id="chart-regions" class="db-chart-host"></div>
    </div>

    <!-- Capacidad de bastidores — barras -->
    <div class="db-card" style="--accent:#8b5cf6" data-preview="racks" tabindex="0" role="button" aria-label="Ver detalle de Capacidad de Bastidores">
      <div class="db-card-hdr">
        <div><div class="db-card-title">Capacidad de Bastidores</div><div class="db-card-sub">Ocupación por rack</div></div>
        <span class="db-chip" id="db-racks-chip">0 racks</span>
      </div>
      <div id="chart-racks" class="db-scroll"></div>
    </div>

  </div>

  <!-- ══ ROW 2 ══════════════════════════════════════════════ -->
  <div class="db-row db-row-2">

    <!-- Categorías — barras horizontales -->
    <div class="db-card" style="--accent:#f59e0b" data-preview="categories" tabindex="0" role="button" aria-label="Ver detalle de Dispositivos por Categoría">
      <div class="db-card-hdr">
        <div><div class="db-card-title">Dispositivos por Categoría</div><div class="db-card-sub">Top categorías del inventario</div></div>
        <span class="db-expand-hint" aria-hidden="true">Ver detalle ↗</span>
      </div>
      <div id="chart-categories" class="db-scroll"></div>
    </div>

    <!-- Incidentes ISP -->
    <div class="db-card" style="--accent:#ef4444" data-preview="incidents" tabindex="0" role="button" aria-label="Ver detalle de Incidentes ISP">
      <div class="db-card-hdr">
        <div><div class="db-card-title">Incidentes ISP</div><div class="db-card-sub">Estado de incidencias</div></div>
        <span class="db-expand-hint" aria-hidden="true">Ver detalle ↗</span>
      </div>
      <div id="chart-incidents-kpis" class="db-inc-kpis"></div>
      <div id="chart-incidents-list" class="db-scroll" style="margin-top:8px"></div>
    </div>

    <!-- ISPs registrados -->
    <div class="db-card" style="--accent:#06b6d4" data-preview="isps" tabindex="0" role="button" aria-label="Ver detalle de ISPs Registrados">
      <div class="db-card-hdr">
        <div><div class="db-card-title">ISPs Registrados</div><div class="db-card-sub">Proveedores por región</div></div>
        <span class="db-expand-hint" aria-hidden="true">Ver detalle ↗</span>
      </div>
      <div id="chart-isps" class="db-scroll"></div>
    </div>

    <!-- Actividad reciente -->
    <div class="db-card" style="--accent:#f97316" data-preview="activity" tabindex="0" role="button" aria-label="Ver detalle de Actividad Reciente">
      <div class="db-card-hdr">
        <div><div class="db-card-title">Actividad Reciente</div><div class="db-card-sub">Últimos accesos</div></div>
        <span class="db-expand-hint" aria-hidden="true">Ver detalle ↗</span>
      </div>
      <div id="chart-activity" class="db-scroll"></div>
    </div>

  </div>

</div>

<style>
/* ── Base ───────────────────────────────────── */
.db {
  height: calc(100vh - 130px);
  display: flex; flex-direction: column; gap: 10px;
  overflow: hidden;
  animation: dbIn .4s cubic-bezier(0.4,0,0.2,1);
}
@keyframes dbIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }

/* ── Header ─────────────────────────────────── */
.db-header {
  flex-shrink: 0; height: 104px; border-radius: 22px;
  display: flex; align-items: center; padding: 0 30px;
  position: relative; overflow: hidden;
  background: linear-gradient(115deg,#0b1222 0%,#152a63 32%,#27225f 62%,#3d1a74 100%);
  box-shadow:
    0 10px 34px rgba(37,99,235,.24),
    0 1px 0 rgba(255,255,255,.1) inset,
    0 -1px 0 rgba(0,0,0,.25) inset;
  color: #fff;
}
.db-header-glow {
  position:absolute;inset:0;pointer-events:none;
  background: radial-gradient(ellipse 55% 80% at 18% 50%,rgba(99,102,241,.2),transparent 58%),
              radial-gradient(ellipse 40% 60% at 82% 30%,rgba(139,92,246,.16),transparent 55%);
}
.db-header-grid {
  position:absolute;inset:0;pointer-events:none;opacity:.1;
  background-image: linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),
                    linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);
  background-size: 32px 32px;
}

/* Reflejo que recorre la barra muy despacio. Va en diagonal y con poca
   opacidad: tiene que insinuarse, no llamar la atención. */
.db-header-sheen {
  position:absolute; inset:-20% -40%; pointer-events:none;
  background: linear-gradient(100deg,
    transparent 38%,
    rgba(255,255,255,.05) 46%,
    rgba(255,255,255,.11) 50%,
    rgba(255,255,255,.05) 54%,
    transparent 62%);
  animation: dbSheen 11s ease-in-out infinite;
}
@keyframes dbSheen {
  0%, 100% { transform: translateX(-46%); }
  50%      { transform: translateX(46%); }
}
@media (prefers-reduced-motion: reduce) {
  .db-header-sheen { animation: none; opacity: .5; }
}

.db-brand { flex-shrink:0; position:relative; z-index:1; padding-right:30px; }

/* El lienzo necesita un ancho DEFINIDO: con un porcentaje dentro de un
   contenedor que se ajusta al contenido, el ancho se calcularía como
   cero y el nombre saldría microscópico (ver .dev-title-canvas). */
.db-brand-canvas {
  width: 300px;
  height: 56px;
  /* Compensa el margen interno de TechText con align="left" (EDGE_PAD) */
  margin-left: -14px;
}

.db-brand-sub {
  font-size:11px;
  color:rgba(255,255,255,.52);
  letter-spacing:.3px;
  margin-top:2px;
}

.db-sep {
  flex-shrink:0; width:1px; height:56px; margin:0 24px;
  /* Difuminado en los extremos: una línea sólida corta demasiado. */
  background: linear-gradient(to bottom, transparent, rgba(255,255,255,.16) 50%, transparent);
}

.db-kv-row { flex:1;display:flex;align-items:center;position:relative;z-index:1; }

.db-kv {
  flex:1; position:relative;
  display:flex; flex-direction:column; align-items:center;
  padding:14px 8px 16px;
  border-radius:14px;
  transition: background .22s ease;
}
.db-kv:hover { background: rgba(255,255,255,.045); }
.db-kv+.db-kv::before {
  content:''; position:absolute; left:0; top:18%; height:64%; width:1px;
  background: linear-gradient(to bottom, transparent, rgba(255,255,255,.13) 50%, transparent);
}

/* El número va en blanco con un degradado suave, y el color de cada dato
   se reserva para la línea de abajo. Seis cifras de seis colores
   distintos competían entre sí; así el conjunto respira. */
.db-kv-n {
  font-size:30px; font-weight:700; line-height:1; letter-spacing:-1.6px;
  font-family:'JetBrains Mono',monospace;
  background: linear-gradient(180deg, #ffffff 0%, rgba(255,255,255,.7) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.db-kv-l {
  font-size:9px; margin-top:8px;
  color:rgba(255,255,255,.5); font-weight:600;
  text-transform:uppercase; letter-spacing:1.4px;
}
.db-kv::after {
  content:''; position:absolute; bottom:6px; left:50%;
  transform:translateX(-50%);
  width:18px; height:2px; border-radius:2px;
  background:var(--kc);
  box-shadow:0 0 12px color-mix(in srgb, var(--kc) 75%, transparent);
  opacity:.9;
  transition: width .22s ease;
}
.db-kv:hover::after { width:30px; }

/* ── Rows ───────────────────────────────────── */
.db-row { flex:1;min-height:0;display:grid;gap:10px; }
.db-row-1 { grid-template-columns:1fr 1fr 1fr; }
.db-row-2 { grid-template-columns:2fr 1fr 1fr 1fr; }

/* ── Cards ──────────────────────────────────── */
.db-card {
  background:var(--surface);border:1px solid var(--border);border-radius:14px;
  padding:14px 16px;box-shadow:var(--shadow-sm);
  display:flex;flex-direction:column;flex:1;min-height:0;overflow:hidden;
  position:relative;transition:box-shadow .3s ease,transform .3s ease,border-color .3s ease;
  --sx:50%;--sy:50%; /* spotlight position */
}
.db-card::before {
  content:'';position:absolute;top:0;left:16px;right:16px;height:2px;
  background:linear-gradient(90deg,var(--accent),color-mix(in srgb,var(--accent) 30%,transparent));
  border-radius:0 0 2px 2px;opacity:.75;
  transition: opacity .3s ease, width .3s ease;
}
/* Spotlight overlay */
.db-card::after {
  content:'';
  position:absolute;inset:0;border-radius:14px;
  background: radial-gradient(300px circle at var(--sx) var(--sy), color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%);
  opacity:0;transition:opacity .35s ease;
  pointer-events:none;z-index:0;
}
.db-card:hover::after { opacity:1; }
.db-card:hover {
  box-shadow: 0 12px 40px rgba(0,0,0,0.18), 0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent);
  transform: translateY(-4px) scale(1.005);
  border-color: color-mix(in srgb, var(--accent) 28%, var(--border));
}
.db-card-hdr  { flex-shrink:0;margin-bottom:10px;display:flex;align-items:flex-start;justify-content:space-between; }
.db-card-title{ font-size:13px;font-weight:700;color:var(--text-main); }
.db-card-sub  { font-size:11px;color:var(--text-muted);margin-top:1px; }
.db-chip {
  font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;flex-shrink:0;
  background:color-mix(in srgb,var(--primary) 10%,transparent);
  color:var(--primary);border:1px solid color-mix(in srgb,var(--primary) 16%,transparent);
}
.db-chart-host { flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column; }
.db-scroll { flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:5px; }
.db-scroll::-webkit-scrollbar { width:3px }
.db-scroll::-webkit-scrollbar-thumb { background:var(--border);border-radius:3px }
.db-inc-kpis { display:grid;grid-template-columns:repeat(4,1fr);gap:6px;flex-shrink:0; }

/* ══ INJECTED HTML (global) ══════════════════ */

/* Shared */
:global(.db-empty) { padding:20px 0;text-align:center;font-size:12px;color:var(--text-muted);font-weight:500; }
:global(.db-bar-bg)   { height:5px;background:var(--surface-3);border-radius:3px;overflow:hidden;margin-top:4px; }
:global(.db-bar-fill) { height:100%;border-radius:3px;transition:width 1.1s cubic-bezier(.4,0,.2,1); }

/* ── Donut chart ────────── */
:global(.dbc-donut) {
  flex:1;min-height:0;display:flex;align-items:center;gap:16px;overflow:hidden;
}
/* El número del centro se coloca sobre el marco (inset:0), así que el
   marco y el dibujo tienen que medir EXACTAMENTE lo mismo: cualquier
   diferencia descoloca el número. Antes el marco llevaba 150px fijos en
   un style en línea y en teléfono solo se encogía el SVG, de modo que el
   número se iba abajo y a la derecha la mitad de esa diferencia.
   Ahora el tamaño sale de una sola variable, que las media queries sí
   pueden cambiar porque ya no hay nada en línea que las pise. El alto no
   se declara: con display:block y height:auto el SVG lo deduce de su
   viewBox y el marco se ajusta a él al milímetro. */
:global(.dbc-svg-wrap) {
  flex-shrink:0; position:relative;
  width: var(--dbc-donut, 150px);
}
:global(.dbc-svg-wrap svg) { display:block; width:100%; height:auto; }
:global(.dbc-center) {
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  pointer-events:none;
}
:global(.dbc-c-num)  { font-size:24px;font-weight:800;color:var(--text-main);line-height:1;font-family:'JetBrains Mono',monospace; }
:global(.dbc-c-lbl)  { font-size:10px;color:var(--text-muted);font-weight:500;margin-top:2px; }
:global(.dbc-legend) { flex:1;min-width:0;display:flex;flex-direction:column;gap:7px;justify-content:center;overflow:hidden; }
:global(.dbc-leg-row){ display:flex;align-items:center;gap:8px;min-width:0; }
:global(.dbc-leg-dot){ width:10px;height:10px;border-radius:3px;flex-shrink:0; }
:global(.dbc-leg-name){ font-size:12px;font-weight:600;color:var(--text-main);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
:global(.dbc-leg-num) { font-size:11.5px;font-weight:700;font-family:'JetBrains Mono',monospace;flex-shrink:0; }
:global(.dbc-leg-pct) { font-size:10px;color:var(--text-muted);flex-shrink:0;width:32px;text-align:right; }

/* ── Category bars ──────── */
:global(.dbc-cat-row) { display:flex;align-items:center;gap:8px;flex-shrink:0;min-width:0; }
:global(.dbc-cat-name){ font-size:11.5px;font-weight:600;color:var(--text-muted);width:100px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
:global(.dbc-cat-bar) { flex:1;height:18px;background:var(--surface-3);border-radius:6px;overflow:hidden;position:relative; }
:global(.dbc-cat-fill){ height:100%;border-radius:6px;transition:width 1.1s cubic-bezier(.4,0,.2,1);display:flex;align-items:center;justify-content:flex-end; }
:global(.dbc-cat-n)   { font-size:10.5px;font-weight:700;color:#fff;padding:0 7px;font-family:'JetBrains Mono',monospace; }

/* ── Rack bars ──────────── */
:global(.dbc-rack-row) { padding:6px 0;border-bottom:1px solid var(--border);flex-shrink:0; }
:global(.dbc-rack-row:last-child) { border-bottom:none }
:global(.dbc-rack-hdr)  { display:flex;justify-content:space-between;align-items:center; }
:global(.dbc-rack-name) { font-size:12.5px;font-weight:600;color:var(--text-main);cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
:global(.dbc-rack-name:hover) { color:var(--primary); }
:global(.dbc-rack-pct)  { font-size:11px;font-weight:700;font-family:'JetBrains Mono',monospace;flex-shrink:0;margin-left:6px; }
:global(.dbc-rack-meta) { font-size:10.5px;color:var(--text-muted);margin-top:1px; }

/* ── Incidents ──────────── */
:global(.dbc-inc-kpi)  { border-radius:9px;padding:9px 5px;text-align:center;border:1px solid;display:flex;flex-direction:column;align-items:center;gap:2px; }
:global(.dbc-inc-n)    { font-size:19px;font-weight:800;line-height:1;font-family:'JetBrains Mono',monospace; }
:global(.dbc-inc-l)    { font-size:9px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;opacity:.75; }
:global(.dbc-inc-item) { display:flex;align-items:center;gap:7px;padding:6px 7px;border-radius:8px;transition:background .15s;flex-shrink:0; }
:global(.dbc-inc-item:hover) { background:var(--surface-2); }
:global(.dbc-inc-dot)  { width:6px;height:6px;border-radius:50%;flex-shrink:0; }
:global(.dbc-inc-body) { flex:1;min-width:0;display:flex;flex-direction:column;gap:1px; }
:global(.dbc-inc-isp)  { font-size:12px;font-weight:600;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
:global(.dbc-inc-meta) { font-size:10px;color:var(--text-muted); }
:global(.dbc-inc-tag)  { font-size:10px;font-weight:600;padding:2px 6px;border-radius:6px;flex-shrink:0; }

/* ── ISPs ───────────────── */
:global(.dbc-isp-row) { display:flex;align-items:center;gap:8px;padding:6px 9px;border-radius:9px;background:var(--surface-2);border:1px solid var(--border);transition:background .15s;flex-shrink:0; }
:global(.dbc-isp-row:hover) { background:var(--surface-3); }
:global(.dbc-isp-dot) { width:8px;height:8px;border-radius:50%;flex-shrink:0; }
:global(.dbc-isp-body){ flex:1;min-width:0; }
:global(.dbc-isp-name){ font-size:12px;font-weight:600;color:var(--text-main); }
:global(.dbc-isp-sub) { font-size:10.5px;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
:global(.dbc-isp-bdg) { font-size:11px;font-weight:700;padding:2px 7px;border-radius:9px;flex-shrink:0; }

/* ── Activity ───────────── */
:global(.dbc-act-row) { display:flex;align-items:center;gap:9px;padding:6px 8px;border-radius:9px;cursor:pointer;transition:background .15s;border:1px solid transparent;flex-shrink:0; }
:global(.dbc-act-row:hover) { background:var(--surface-2);border-color:var(--border); }
:global(.dbc-act-ico) { width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
:global(.dbc-act-body){ flex:1;min-width:0;display:flex;flex-direction:column;gap:1px; }
:global(.dbc-act-name){ font-size:12px;font-weight:600;color:var(--text-main);overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
:global(.dbc-act-type){ font-size:10px;color:var(--text-muted); }
:global(.dbc-act-time){ font-size:10px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;flex-shrink:0; }

/* ============================================================
   RESPONSIVE
   En escritorio el dashboard es una rejilla de altura fija (100vh)
   pensada para verse entera de un vistazo. Eso no funciona en
   pantallas pequeñas: aquí pasa a ser una columna de tarjetas que
   crecen con su contenido y se recorren con el scroll normal de la
   página, sin scroll anidado dentro de cada tarjeta.
   ============================================================ */

/* ── Tablet ─────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .db {
    height: auto;        /* se quita el alto fijo de 100vh */
    overflow: visible;
  }
  /* auto-fit reparte las tarjetas solo: 3 ó 2 columnas según quepa */
  .db-row-1, .db-row-2 {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .db-card { min-height: 260px; }

  .db-header { height: auto; flex-direction: column; padding: 22px 20px 18px; gap: 16px; }
  .db-brand  { padding-right: 0; width: 100%; display: flex; flex-direction: column; align-items: center; }
  /* El nombre se centra: el lienzo pasa a medir lo justo y se dibuja
     centrado, en vez de pegado al borde izquierdo. */
  .db-brand-canvas { width: 260px; height: 50px; margin-left: 0; }
  .db-brand-sub    { text-align: center; }
  .db-sep    { display: none; }
  .db-kv-row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    border-top: 1px solid rgba(255,255,255,.1);
    padding-top: 10px;
  }
  .db-kv + .db-kv::before { display: none; } /* los separadores solo valen en fila */
}

/* ── Teléfono ───────────────────────────────────────────── */
@media (max-width: 768px) {
  .db { gap: 12px; }

  .db-row-1, .db-row-2 { grid-template-columns: 1fr; gap: 12px; }

  /* Altura según contenido: con 7 tarjetas apiladas, forzar 280px a
     cada una obligaba a recorrer huecos vacíos. */
  .db-card { min-height: auto; padding: 13px 14px; }

  /* Las listas largas conservan su propio scroll pero acotado, para
     que una tarjeta corta no deje espacio muerto. */
  .db-scroll { max-height: 230px; }

  /* Cabecera compacta */
  .db-header       { padding: 18px 14px 14px; gap: 12px; border-radius: 16px; }
  .db-brand-canvas { width: 212px; height: 42px; }
  .db-brand-sub    { font-size: 10px; }
  .db-kv-row       { gap: 4px; }
  .db-kv           { padding: 9px 2px 12px; }
  .db-kv-n         { font-size: 21px; letter-spacing: -.9px; }
  .db-kv-l         { font-size: 8px; letter-spacing: .9px; margin-top: 6px; }
  .db-kv::after    { width: 14px; bottom: 4px; }

  /* Se encoge el donut para dejarle sitio a la leyenda. */
  :global(.dbc-donut)        { gap: 12px; }
  :global(.dbc-svg-wrap)     { --dbc-donut: 124px; }
  :global(.dbc-c-num)        { font-size: 20px; }

  /* Cuatro columnas de KPI eran ilegibles a este ancho */
  .db-inc-kpis { grid-template-columns: 1fr 1fr; gap: 8px; }
}

/* ── Teléfono estrecho ──────────────────────────────────── */
@media (max-width: 480px) {
  .db-header     { padding: 14px 12px; }
  .db-kv-row     { gap: 10px 4px; }
  .db-kv-n       { font-size: 17px; }
  .db-card       { padding: 12px; }
  .db-card-title { font-size: 12.5px; }
  .db-card-sub   { font-size: 10px; }
  .db-expand-hint{ font-size: 9px; padding: 2px 6px; }

  /* Lado a lado, la leyenda quedaba cortada a puntos suspensivos:
     mejor el donut arriba y la leyenda entera debajo. */
  :global(.dbc-donut)        { flex-direction: column; align-items: center; gap: 10px; }
  :global(.dbc-legend)       { width: 100%; }
  :global(.dbc-svg-wrap)     { --dbc-donut: 132px; }
}

/* ── Dispositivos táctiles ──────────────────────────────── */
@media (hover: none) {
  /* Sin ratón no hay hover: el aviso "Ver detalle" quedaba invisible
     para siempre y nada sugería que la tarjeta se puede tocar. */
  .db-card[data-preview] .db-expand-hint { opacity: 1; transform: none; }

  /* Elevaciones y foco de luz solo estorban al tocar (y el :hover se
     queda "pegado" tras el toque en varios navegadores móviles). */
  .db-card:hover {
    transform: none;
    box-shadow: var(--shadow-sm);
    border-color: var(--border);
  }
  .db-card:hover::after { opacity: 0; }
  .db-kv:hover { transform: none; }

  /* Respuesta táctil al pulsar, que sí aporta */
  .db-card[data-preview]:active { transform: scale(.99); }
}


/* Staggered row entrance */
:global(.db-anim-row) {
  animation: dbRowIn .35s cubic-bezier(0.4,0,0.2,1) both;
}
@keyframes dbRowIn {
  from { opacity:0; transform: translateX(-8px); }
  to   { opacity:1; transform: none; }
}

/* KPI hover lift */
.db-kv {
  cursor: default;
  transition: transform .2s cubic-bezier(0.34,1.56,0.64,1);
}
.db-kv:hover { transform: translateY(-3px) scale(1.08); }
.db-kv-n { transition: text-shadow .3s; }
.db-kv:hover .db-kv-n {
  text-shadow: 0 0 24px color-mix(in srgb,var(--kc) 85%,transparent);
}

/* Rack name hover highlight */
:global(.dbc-rack-row) {
  transition: background .2s ease, padding-left .2s ease;
  padding: 6px 8px;
  border-radius: 8px;
  border-bottom:1px solid var(--border);
}
:global(.dbc-rack-row:hover) {
  background: var(--surface-2);
  padding-left: 14px;
}
:global(.dbc-rack-row:last-child) { border-bottom:none }

/* Activity row pulse on hover */
:global(.dbc-act-row:hover .dbc-act-ico) {
  transform: scale(1.18) rotate(-6deg);
  transition: transform .25s cubic-bezier(0.34,1.56,0.64,1);
}
:global(.dbc-act-ico) { transition: transform .25s ease; }

/* ISP dot pulse */
:global(.dbc-isp-row:hover .dbc-isp-dot) {
  transform: scale(1.5);
  box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 20%, transparent);
}
:global(.dbc-isp-dot) { transition: transform .2s ease, box-shadow .2s ease; }

/* Incident KPI hover */
:global(.dbc-inc-kpi) {
  transition: transform .25s cubic-bezier(0.34,1.56,0.64,1), box-shadow .25s ease;
}
:global(.dbc-inc-kpi:hover) {
  transform: translateY(-3px) scale(1.04);
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

/* ── Clickable card hint ────────────────────────────── */
.db-card[data-preview] { cursor: pointer; }
.db-card[data-preview]:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}
.db-expand-hint {
  font-size: 10px;
  font-weight: 600;
  color: color-mix(in srgb, var(--accent) 75%, transparent);
  background: color-mix(in srgb, var(--accent) 8%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
  padding: 3px 8px;
  border-radius: 20px;
  white-space: nowrap;
  flex-shrink: 0;
  opacity: 0;
  transform: translateX(4px);
  transition: opacity .25s ease, transform .25s ease;
}
.db-card[data-preview]:hover .db-expand-hint,
.db-card[data-preview]:focus-visible .db-expand-hint {
  opacity: 1;
  transform: none;
}

/* ════════════════════════════════════════════════════════
   PREVIEW MODAL (.dbp-*)
   ════════════════════════════════════════════════════════ */
:global(body.dbp-open) { overflow: hidden; }

/* ── Cristal ─────────────────────────────────────────────
   El desenfoque lo hace LA VENTANA, no sus piezas internas: un
   backdrop-filter anidado no difumina lo que se pinta dentro de su
   propio contenedor, así que ponerlo en las tarjetas o la tabla no
   haría nada y solo las dejaría transparentes.

   El reparto es: el velo del fondo ya emborrona el dashboard, y
   encima la lámina blanca a 0.74 lo convierte en una mancha de color
   sin forma. Por eso el contenido se sigue leyendo: lo de atrás llega
   difuminado DOS veces y sin contraste propio.

   Las superficies de dentro (tarjetas, tabla, panel del gráfico) son
   capas opacas sobre esa lámina; el texto nunca se apoya directamente
   sobre lo transparente. */
:global(.dbp-overlay) {
  position: fixed; inset: 0; z-index: var(--z-preview);
  /* Velo suave: lo justo para separar la ventana del dashboard sin
     oscurecerlo ni borrarlo. El grueso del difuminado lo hace la propia
     ventana, no esta capa. */
  background: rgba(15, 23, 42, 0.24);
  backdrop-filter: blur(9px) saturate(125%);
  -webkit-backdrop-filter: blur(9px) saturate(125%);
  display: flex; align-items: center; justify-content: center;
  padding: 24px;
  opacity: 0;
  transition: opacity .22s ease;
  --dbp-accent: #3b82f6;
}
:global(.dbp-overlay.dbp-show) { opacity: 1; }

:global(.dbp-modal) {
  width: min(1180px, 100%);
  max-height: calc(var(--vh-util) * 0.92);
  /* El marco baja a 0.70 para que se vea más vidrio; lo que compensa la
     legibilidad son las superficies internas, que suben de opacidad.
     Es el reparto de iOS: el marco es cristal, el contenido se apoya en
     material sólido.

     Encima van dos degradados que son el brillo: una franja clara en el
     borde superior y un reflejo diagonal que cruza la esquina. Van en el
     propio fondo y no en un ::before porque un pseudoelemento colocado
     se pintaría POR ENCIMA del contenido y lo velaría. */
  background:
    linear-gradient(to bottom,
      rgba(255, 255, 255, 0.55) 0px,
      rgba(255, 255, 255, 0) 150px),
    linear-gradient(135deg,
      rgba(255, 255, 255, 0.50) 0%,
      rgba(255, 255, 255, 0.10) 32%,
      rgba(255, 255, 255, 0) 52%),
    rgba(255, 255, 255, 0.60);
  /* brightness y contrast son la clave para bajar tanto la capa blanca:
     aclaran y aplanan lo que hay detrás, de modo que llega como un campo
     de color uniforme en vez de formas con contraste. Sin eso, a esta
     opacidad el dashboard se leería a través del cristal.
     Aquí sí se difumina fuerte: es lo que separa la ventana del fondo
     ahora que el velo de atrás es suave. */
  backdrop-filter: blur(72px) saturate(175%) brightness(1.2) contrast(0.74);
  -webkit-backdrop-filter: blur(72px) saturate(175%) brightness(1.2) contrast(0.74);
  border-radius: 32px;
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow:
    0 44px 100px -22px rgba(8, 12, 24, 0.58),
    0 2px 10px rgba(8, 12, 24, 0.12),
    /* El canto del vidrio: luz arriba, algo menos en los laterales y
       una sombra fina abajo. Es lo que le da el grosor. */
    inset 0 1px 0 rgba(255, 255, 255, 1),
    inset 1px 0 0 rgba(255, 255, 255, 0.6),
    inset -1px 0 0 rgba(255, 255, 255, 0.3),
    inset 0 -1px 0 rgba(15, 23, 42, 0.07);
  display: flex; flex-direction: column;
  overflow: hidden;
  transform: scale(.94) translateY(20px);
  opacity: 0;
  transition: transform .32s cubic-bezier(0.34,1.4,0.64,1), opacity .26s ease;
}

/* Sin desenfoque de fondo no hay cristal que valga: la ventana pasa a
   ser opaca antes que dejar el texto sobre el dashboard. */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  :global(.dbp-modal)   { background: #ffffff; }
  :global(.dbp-overlay) { background: rgba(10, 14, 28, 0.72); }
  /* Sin cristal detrás, las piezas translúcidas se vuelven sólidas. */
  :global(.dbp-kpi),
  :global(.dbp-table-scroll) { background: #ffffff; }
  :global(.dbp-chart)        { background: #f8fafc; }
}
:global(.dbp-overlay.dbp-show .dbp-modal) {
  transform: none;
  opacity: 1;
}

/* ── Header ──────────────────────────── */
:global(.dbp-head) {
  position: relative;
  padding: 22px 28px 18px;
  display: flex; align-items: flex-start; gap: 18px;
  /* Tinte del color de la tarjeta sobre una capa clara. No baja de 0.26
     en la cola: por debajo de eso se transparentaba el fantasma del
     texto del dashboard justo detrás del título. */
  background: linear-gradient(135deg,
    color-mix(in srgb, var(--dbp-accent) 13%, rgba(255,255,255,0.46)) 0%,
    rgba(255, 255, 255, 0.26) 72%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.5);
}
:global(.dbp-head-bar) {
  position: absolute; top: 0; left: 0; right: 0; height: 4px;
  background: linear-gradient(90deg,
    var(--dbp-accent),
    color-mix(in srgb, var(--dbp-accent) 40%, transparent));
}
:global(.dbp-head-info) { flex: 1; min-width: 0; }
:global(.dbp-eyebrow) {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--dbp-accent);
  margin-bottom: 6px;
}
:global(.dbp-title) {
  font-size: 24px; font-weight: 800;
  color: var(--text-main); line-height: 1.15;
  letter-spacing: -.6px;
  margin: 0;
}
:global(.dbp-sub) {
  font-size: 13px; color: var(--text-muted);
  margin-top: 4px;
}
:global(.dbp-close) {
  flex-shrink: 0;
  width: 38px; height: 38px;
  /* Redondo, como los botones de cerrar de iOS */
  border-radius: 50%;
  background:
    linear-gradient(to bottom, rgba(255,255,255,0.9), rgba(255,255,255,0.55));
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 2px 6px rgba(15, 23, 42, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 1);
  color: var(--text-muted);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all .18s ease;
}
:global(.dbp-close svg) { width: 18px; height: 18px; }
:global(.dbp-close:hover) {
  background: color-mix(in srgb, var(--danger) 14%, var(--surface-2));
  border-color: color-mix(in srgb, var(--danger) 35%, var(--border));
  color: var(--danger);
  transform: rotate(90deg);
}

/* ── KPI strip ──────────────────────── */
:global(.dbp-kpis) {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  padding: 16px 28px;
  /* Sin fondo propio: esta franja deja ver el cristal de la ventana. */
  background: transparent;
  border-bottom: 1px solid rgba(255, 255, 255, 0.45);
}
:global(.dbp-kpi) {
  display: flex; flex-direction: column; gap: 4px;
  padding: 12px 14px;
  /* Pastillas de vidrio sobre el vidrio: translúcidas, con su reflejo
     arriba. Las cifras son grandes y en negrita, así que aguantan esta
     opacidad sin perder nitidez. */
  background:
    linear-gradient(to bottom, rgba(255,255,255,0.78), rgba(255,255,255,0.52));
  border: 1px solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 2px 10px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  border-radius: 18px;
  border-left: 3px solid var(--c);
  transition: transform .2s ease, box-shadow .2s ease;
}
:global(.dbp-kpi:hover) {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0,0,0,.08);
}
:global(.dbp-kpi-n) {
  font-size: 22px;
  font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
  color: var(--c);
  line-height: 1;
  letter-spacing: -.5px;
}
:global(.dbp-kpi-l) {
  font-size: 10.5px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .4px;
}

/* ── Body / sections ────────────────── */
:global(.dbp-body) {
  flex: 1; min-height: 0;
  display: grid;
  /* minmax(0,1fr) y no 1fr: un grid item usa min-width:auto por defecto,
     así que la tabla (con cabeceras nowrap) estiraba la rejilla hasta
     sacar el modal de la pantalla en vez de dejar scrollear la tabla. */
  grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
  gap: 0;
  overflow: hidden;
}
:global(.dbp-chart),
:global(.dbp-table-wrap) {
  padding: 18px 22px;
  display: flex; flex-direction: column;
  min-height: 0;
  min-width: 0;   /* ver nota de arriba */
}
:global(.dbp-chart) {
  background: rgba(255, 255, 255, 0.10);
  border-right: 1px solid rgba(255, 255, 255, 0.45);
}
:global(.dbp-section-hdr) {
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}
:global(.dbp-section-title) {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-main);
  text-transform: uppercase;
  letter-spacing: .4px;
}
:global(.dbp-chart-host) {
  flex: 1; min-height: 0;
  display: flex; align-items: center; justify-content: center;
}

/* ── Donut grande ───────────────────── */
:global(.dbp-donut-wrap) {
  display: flex; flex-direction: column;
  align-items: center;
  gap: 22px;
  width: 100%;
}
/* Mismo criterio que .dbc-svg-wrap: marco y dibujo del mismo tamaño, o
   el número del centro se descoloca. El min() hace que en pantallas
   estrechas se encoja en lugar de salirse. */
:global(.dbp-svg-host) {
  position: relative; flex-shrink: 0;
  width: min(220px, 100%);
}
:global(.dbp-svg-host svg) { display: block; width: 100%; height: auto; }
:global(.dbp-svg-center) {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  pointer-events: none;
}
:global(.dbp-c-n) {
  font-size: 32px; font-weight: 800;
  color: var(--text-main); line-height: 1;
  font-family: 'JetBrains Mono', monospace;
  letter-spacing: -1px;
}
:global(.dbp-c-l) {
  font-size: 11px; color: var(--text-muted);
  margin-top: 4px; font-weight: 500;
}
:global(.dbp-legend) {
  width: 100%;
  display: flex; flex-direction: column; gap: 8px;
  max-height: 180px;
  overflow-y: auto;
}
:global(.dbp-leg-row) {
  display: flex; align-items: center; gap: 10px;
  padding: 6px 8px;
  border-radius: 8px;
  transition: background .15s ease;
}
:global(.dbp-leg-row:hover) { background: var(--surface); }
:global(.dbp-leg-dot) {
  width: 12px; height: 12px;
  border-radius: 3px; flex-shrink: 0;
}
:global(.dbp-leg-name) {
  flex: 1; min-width: 0;
  font-size: 12.5px; font-weight: 600;
  color: var(--text-main);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
:global(.dbp-leg-num) {
  font-size: 13px; font-weight: 700;
  font-family: 'JetBrains Mono', monospace;
  flex-shrink: 0;
}
:global(.dbp-leg-pct) {
  font-size: 11px; color: var(--text-muted);
  flex-shrink: 0; width: 38px; text-align: right;
}

/* ── Bar chart grande ───────────────── */
:global(.dbp-bars) {
  width: 100%;
  display: flex; flex-direction: column; gap: 10px;
}
:global(.dbp-bar-row) {
  display: flex; align-items: center; gap: 10px;
}
:global(.dbp-bar-lbl) {
  font-size: 12px; font-weight: 600;
  color: var(--text-muted);
  width: 110px; flex-shrink: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
:global(.dbp-bar-track) {
  flex: 1; height: 22px;
  background: var(--surface-3);
  border-radius: 7px;
  overflow: hidden;
}
:global(.dbp-bar-fill) {
  height: 100%; border-radius: 7px;
  display: flex; align-items: center; justify-content: flex-end;
  transition: width 1.1s cubic-bezier(.4,0,.2,1);
}
:global(.dbp-bar-n) {
  font-size: 11px; font-weight: 700;
  color: #fff; padding: 0 9px;
  font-family: 'JetBrains Mono', monospace;
}

/* ── Tools (filtros + búsqueda + export) ────────────── */
:global(.dbp-tools) {
  display: flex; align-items: center; gap: 8px;
  flex-wrap: wrap;
}
:global(.dbp-search) {
  display: flex; align-items: center; gap: 6px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.95), rgba(255,255,255,0.8));
  border: 1px solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.07), inset 0 1px 0 rgba(255,255,255,1);
  border-radius: 12px;
  padding: 6px 10px;
  transition: border-color .18s ease;
}
:global(.dbp-search:focus-within) {
  border-color: var(--dbp-accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--dbp-accent) 15%, transparent);
}
:global(.dbp-search svg) {
  width: 14px; height: 14px;
  color: var(--text-muted); flex-shrink: 0;
}
:global(.dbp-search input) {
  border: none; outline: none; background: transparent;
  font-size: 12.5px; color: var(--text-main);
  width: 160px;
  font-family: inherit;
}
:global(.dbp-filter-select) {
  background: linear-gradient(to bottom, rgba(255,255,255,0.95), rgba(255,255,255,0.8));
  border: 1px solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.07), inset 0 1px 0 rgba(255,255,255,1);
  border-radius: 12px;
  padding: 7px 10px;
  font-size: 12.5px;
  color: var(--text-main);
  font-family: inherit;
  cursor: pointer;
  transition: border-color .18s ease;
  max-width: 180px;
}
:global(.dbp-filter-select:hover) { border-color: var(--text-muted); }
:global(.dbp-filter-select:focus) {
  outline: none;
  border-color: var(--dbp-accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--dbp-accent) 15%, transparent);
}
:global(.dbp-btn) {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 12px;
  border-radius: 12px;
  font-size: 12px; font-weight: 600;
  border: 1px solid rgba(255, 255, 255, 0.95);
  background: linear-gradient(to bottom, rgba(255,255,255,0.95), rgba(255,255,255,0.8));
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.07), inset 0 1px 0 rgba(255,255,255,1);
  color: var(--text-main);
  cursor: pointer;
  transition: all .18s ease;
  font-family: inherit;
}
:global(.dbp-btn:hover) {
  background: var(--dbp-accent);
  border-color: var(--dbp-accent);
  color: #fff;
}
:global(.dbp-btn-export svg) { transition: transform .2s ease; }
:global(.dbp-btn-export:hover svg) { transform: translateY(2px); }

/* ── Tabla ──────────────────────────── */
:global(.dbp-table-scroll) {
  flex: 1; min-height: 0;
  overflow: auto;
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: 20px;
  /* La más sólida de las piezas: es texto pequeño y denso, y es lo que
     permite que todo lo demás pueda ser más transparente. */
  background: rgba(255, 255, 255, 0.78);
  box-shadow:
    0 3px 14px rgba(15, 23, 42, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}
:global(.dbp-table-scroll::-webkit-scrollbar) { width: 8px; height: 8px; }
:global(.dbp-table-scroll::-webkit-scrollbar-thumb) {
  background: var(--border); border-radius: 4px;
}
:global(.dbp-table) {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
}
:global(.dbp-table thead) {
  position: sticky; top: 0; z-index: 1;
  /* Opaca por obligación, no por estética: es cabecera fija y las filas
     pasan por debajo al desplazar. Translúcida se verían a través. */
  background: #f2f6fb;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 1);
}
:global(.dbp-table th) {
  text-align: left;
  padding: 10px 14px;
  font-size: 10.5px; font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .5px;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
:global(.dbp-table td) {
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  color: var(--text-main);
  vertical-align: middle;
}
:global(.dbp-table tbody tr:hover) { background: var(--surface-2); }
:global(.dbp-table tbody tr:last-child td) { border-bottom: none; }

:global(.dbp-empty) {
  text-align: center; padding: 32px 12px !important;
  color: var(--text-muted);
  font-style: italic;
}
:global(.dbp-empty-state) {
  text-align: center;
  padding: 40px 20px;
  color: var(--text-muted);
  font-size: 13px;
}

/* ── Cells ──────────────────────────── */
:global(.dbp-pill) {
  display: inline-block;
  padding: 3px 9px;
  border-radius: 12px;
  font-size: 10.5px;
  font-weight: 700;
  background: color-mix(in srgb, var(--c) 14%, transparent);
  color: var(--c);
  border: 1px solid color-mix(in srgb, var(--c) 28%, transparent);
}
:global(.dbp-dot) {
  display: inline-block;
  width: 9px; height: 9px;
  border-radius: 3px;
  margin-right: 4px;
  vertical-align: middle;
}
:global(.dbp-mini-bar) {
  display: inline-block;
  width: 80px; height: 6px;
  background: var(--surface-3);
  border-radius: 3px;
  overflow: hidden;
  vertical-align: middle;
  margin-right: 6px;
}
:global(.dbp-mini-bar > span) {
  display: block; height: 100%;
  border-radius: 3px;
  transition: width 1s cubic-bezier(.4,0,.2,1);
}
:global(.dbp-link) {
  color: var(--primary);
  text-decoration: none;
  transition: color .15s ease;
}
:global(.dbp-link:hover) {
  color: var(--primary-hover);
  text-decoration: underline;
}

/* ── Responsive ─────────────────────── */
@media (max-width: 1024px) {
  :global(.dbp-overlay) { padding: 12px; }
  :global(.dbp-modal) {
    max-height: calc(var(--vh-util) * 0.96 - env(safe-area-inset-bottom, 0px));
  }
  :global(.dbp-kpis) { grid-template-columns: repeat(2, 1fr); }
  :global(.dbp-body) {
    grid-template-columns: minmax(0, 1fr);
    overflow-y: auto;
  }
  :global(.dbp-chart) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
  :global(.dbp-title) { font-size: 20px; }
}

/* ── Teléfono ───────────────────────────────────────────── */
@media (max-width: 600px) {
  :global(.dbp-overlay) { padding: 0; align-items: stretch; }
  /* A pantalla completa: a este ancho, los márgenes del overlay solo
     robaban espacio útil. */
  :global(.dbp-modal) {
    width: 100%;
    max-height: 100%;
    border-radius: 0;
  }

  :global(.dbp-head)  { padding: 16px 16px 14px; }
  :global(.dbp-title) { font-size: 18px; }
  :global(.dbp-sub)   { font-size: 12px; }
  :global(.dbp-kpis)  { grid-template-columns: 1fr 1fr; gap: 8px; padding: 12px 16px; }
  :global(.dbp-chart), :global(.dbp-table-wrap) { padding: 14px 16px; }

  /* El cuerpo deja de ser rejilla: en vertical, columna simple que
     fluye con el contenido y se desplaza como una sola página. */
  :global(.dbp-body) {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  /* min-height:auto y flex:none son la corrección clave: con min-height:0
     las secciones se comprimían por debajo de su contenido y, como
     .dbp-chart-host centra con align-items:center, lo que no cabía se
     desbordaba por ARRIBA y por ABAJO a la vez — de ahí que el título
     "Visualización" y el bloque "Detalle" quedaran tapados. */
  :global(.dbp-chart),
  :global(.dbp-table-wrap) { min-height: auto; flex: none; }
  :global(.dbp-chart-host) {
    flex: none;
    min-height: auto;
    align-items: stretch;
  }

  :global(.dbp-donut-wrap)   { gap: 16px; }
  :global(.dbp-c-n)          { font-size: 26px; }

  /* Fuera el scroll anidado: el modal entero ya se desplaza, y una
     leyenda con su propia barra dentro resultaba incómoda. */
  :global(.dbp-legend) { max-height: none; overflow-y: visible; }

  /* Barras: la etiqueta pasa encima. Con 110px fijos a la izquierda,
     nombres como ND_ADMIN_BROC se cortaban con puntos suspensivos. */
  :global(.dbp-bar-row)   { flex-direction: column; align-items: stretch; gap: 4px; }
  :global(.dbp-bar-lbl)   { width: auto; font-size: 11.5px; }
  :global(.dbp-bar-track) { height: 18px; }

  /* Buscador y filtros en su propia fila, ocupando el ancho */
  :global(.dbp-section-hdr)   { gap: 8px; }
  :global(.dbp-tools)         { width: 100%; }
  :global(.dbp-search)        { flex: 1; min-width: 0; }
  :global(.dbp-search input)  { width: 100%; min-width: 0; }
  :global(.dbp-filter-select) { flex: 1; min-width: 0; max-width: none; font-size: 12px; }
  :global(.dbp-btn-export span) { display: none; }

  /* ── La tabla pasa a tarjetas ──────────────────────────
     Con 6 columnas no hay ancho de teléfono que valga: el scroll
     horizontal partía las palabras a media pantalla. Cada fila se
     convierte en una tarjeta y cada celda muestra su encabezado
     (viene en data-label desde dashboardPreview.js), así que ya no
     hace falta desplazarse de lado. El <thead> sobra aquí. */
  :global(.dbp-table-scroll) {
    overflow-x: hidden;
    max-height: none;
    border: none;
    background: transparent;
  }
  :global(.dbp-table) { font-size: 12.5px; }
  :global(.dbp-table thead) { display: none; }
  :global(.dbp-table),
  :global(.dbp-table tbody),
  :global(.dbp-table tr),
  :global(.dbp-table td) { display: block; width: 100%; }

  :global(.dbp-table tr) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 8px;
    padding: 4px 0;
    overflow: hidden;
  }
  :global(.dbp-table tbody tr:hover) { background: var(--surface); }

  :global(.dbp-table td) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 7px 13px;
    border-bottom: none;
    text-align: right;
    overflow-wrap: anywhere;
  }
  :global(.dbp-table td + td) { border-top: 1px solid var(--surface-3); }
  :global(.dbp-table td::before) {
    content: attr(data-label);
    flex-shrink: 0;
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: var(--text-muted);
  }

  /* La fila de "Sin resultados" no es una tarjeta de datos */
  :global(.dbp-table td.dbp-empty) { display: block; text-align: center; }
  :global(.dbp-table td.dbp-empty::before) { content: none; }
}
</style>

<script>
  import { load } from '../scripts/store.js';
  import { initDashboard } from '../scripts/views/dashboard.js';
  import { openCardPreview } from '../scripts/views/dashboardPreview.js';
  document.addEventListener('astro:page-load', async () => {
    if (window.location.pathname !== '/' && window.location.pathname !== '/index') return;
    await load();
    initDashboard();

    // ── Cursor spotlight on cards ─────────────────────────
    document.querySelectorAll('.db-card').forEach(card => {
      card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--sx', `${x}px`);
        card.style.setProperty('--sy', `${y}px`);
      });
    });

    // ── Click → preview modal ─────────────────────────────
    document.querySelectorAll('.db-card[data-preview]').forEach(card => {
      const key = card.dataset.preview;
      const open = () => openCardPreview(key);
      card.addEventListener('click', e => {
        // Evita abrir si se hizo click en un enlace o botón interno
        if (e.target.closest('a, button, .dbc-rack-name, .dbc-act-row')) return;
        open();
      });
      card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
    });

    // ── Staggered entrance for scrollable rows ────────────
    const animateRows = (selector) => {
      document.querySelectorAll(selector).forEach((row, i) => {
        row.classList.add('db-anim-row');
        row.style.animationDelay = `${i * 55}ms`;
      });
    };
    // Small delay to let JS inject the HTML first
    setTimeout(() => {
      animateRows('.dbc-rack-row');
      animateRows('.dbc-cat-row');
      animateRows('.dbc-isp-row');
      animateRows('.dbc-act-row');
      animateRows('.dbc-inc-item');
    }, 100);
  });
</script>
