---
import '../styles/notes.css';
---

<section class="nw" id="nw-root">

  <!-- ── Cabecera del workspace ───────────────────────────── -->
  <header class="nw-head">
    <div class="nw-head-bar"></div>
    <!-- Salida del "modo app" (solo teléfono): en escritorio se sale por
         el menú lateral, que aquí queda tapado por la pantalla completa. -->
    <a class="nw-back" href="/" aria-label="Salir del espacio de trabajo" title="Salir">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
      </svg>
    </a>
    <div class="nw-head-left">
      <div class="nw-eyebrow">Workspace personal</div>
      <h1 class="nw-title">Mi Espacio de Trabajo</h1>
      <p class="nw-sub">Apuntes, credenciales, comandos y planos — todo en un mismo lugar.</p>
    </div>
    <div class="nw-head-right">
      <button class="nw-theme-toggle" id="nw-theme-toggle" title="Cambiar tema oscuro/claro" aria-label="Cambiar tema">
        <svg class="nw-tt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="nw-tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
      <div class="nw-stat" data-stat="notes"><span class="nw-stat-n">0</span><span class="nw-stat-l">Notas</span></div>
      <div class="nw-stat" data-stat="credentials"><span class="nw-stat-n">0</span><span class="nw-stat-l">Bóveda</span></div>
      <div class="nw-stat" data-stat="commands"><span class="nw-stat-n">0</span><span class="nw-stat-l">Comandos</span></div>
      <div class="nw-stat" data-stat="drawings"><span class="nw-stat-n">0</span><span class="nw-stat-l">Planos</span></div>
    </div>
  </header>

  <!-- ── Navegación entre secciones (tipo "wallet") ───────── -->
  <nav class="nw-tabs" role="tablist">
    <button class="nw-tab" role="tab" data-section="apuntes" style="--c:#3b82f6">
      <span class="nw-tab-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>
      </span>
      <span class="nw-tab-body">
        <span class="nw-tab-name">Apuntes</span>
        <span class="nw-tab-desc">Notas y carpetas</span>
      </span>
    </button>

    <button class="nw-tab" role="tab" data-section="boveda" style="--c:#10b981">
      <span class="nw-tab-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
      </span>
      <span class="nw-tab-body">
        <span class="nw-tab-name">Bóveda</span>
        <span class="nw-tab-desc">Credenciales seguras</span>
      </span>
    </button>

    <button class="nw-tab" role="tab" data-section="comandos" style="--c:#8b5cf6">
      <span class="nw-tab-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
      </span>
      <span class="nw-tab-body">
        <span class="nw-tab-name">Comandos</span>
        <span class="nw-tab-desc">Snippets reutilizables</span>
      </span>
    </button>

    <button class="nw-tab" role="tab" data-section="planos" style="--c:#f59e0b">
      <span class="nw-tab-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2-2-2-2 2-2-2-2 2-2-2-2 2-2-2v18l2-2 2 2 2-2 2 2 2-2 2 2 2-2 2 2 2-2V2z"/><line x1="7" y1="8" x2="17" y2="8"/><line x1="7" y1="13" x2="13" y2="13"/></svg>
      </span>
      <span class="nw-tab-body">
        <span class="nw-tab-name">Planos</span>
        <span class="nw-tab-desc">Diseño 2D técnico</span>
      </span>
    </button>
  </nav>

  <!-- ── Contenedor donde cada sección monta su UI ────────── -->
  <div class="nw-content" id="nw-content">
    <div class="nw-loading">
      <div class="nw-spinner"></div>
      <span>Cargando workspace…</span>
    </div>
  </div>

  <!-- Botón de crear flotante (solo teléfono). Reutiliza el botón "nueva"
       de la sección activa, así no duplica lógica. -->
  <button class="nw-fab" id="nw-fab" aria-label="Crear nuevo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    </svg>
  </button>

</section>

<script>
  import { initNotesApp } from '../scripts/views/notes/notesApp.js';

  const THEME_KEY = 'databox_notes_theme';

  function applyTheme() {
    const isDark = localStorage.getItem(THEME_KEY) === 'dark';
    document.documentElement.classList.toggle('nw-dark', isDark);
  }
  function toggleTheme() {
    const cur = localStorage.getItem(THEME_KEY) === 'dark';
    localStorage.setItem(THEME_KEY, cur ? 'light' : 'dark');
    applyTheme();
  }

  document.addEventListener('astro:page-load', () => {
    const path = window.location.pathname.replace(/\/$/, '');
    const role = sessionStorage.getItem('databox_role');
    const isOnNotas = path === '/notas';
    const isViewerOnNotas = isOnNotas && role === 'viewer';

    // Modo app: en teléfono Notas ocupa la pantalla entera, así que la
    // página de detrás no debe desplazarse (el CSS acota el efecto a móvil).
    document.body.classList.toggle('nw-app-mode', isOnNotas);

    if (isOnNotas) {
      applyTheme();
      document.getElementById('nw-theme-toggle')?.addEventListener('click', toggleTheme);
    } else {
      // Fuera de /notas, asegurarnos de que no quede activado
      document.documentElement.classList.remove('nw-dark');
    }

    // Si es viewer en /notas, mantenemos el overlay de "Cargando" visible
    // mientras se renderiza el acceso denegado, evitando el "pantallazo"
    // del contenido por defecto del módulo.
    let heldOverlay = false;
    if (isViewerOnNotas) {
      document.documentElement.classList.add('page-loading');
      const ov = document.getElementById('page-loading-overlay');
      if (ov) {
        ov.style.transition = 'none';
        ov.style.opacity = '1';
        ov.style.pointerEvents = 'all';
        heldOverlay = true;
      }
    }

    if (!document.getElementById('nw-root')) return;
    initNotesApp();

    // Después de pintar el acceso denegado, soltamos el overlay con fade
    if (heldOverlay) {
      requestAnimationFrame(() => requestAnimationFrame(() => {
        const ov = document.getElementById('page-loading-overlay');
        if (ov) {
          ov.style.transition = 'opacity 0.3s ease';
          ov.style.opacity = '0';
          ov.style.pointerEvents = 'none';
          setTimeout(() => document.documentElement.classList.remove('page-loading'), 320);
        }
      }));
    }
  });

  // ── Cleanup global del modo pantalla completa de Planos ──────────
  // Si el usuario navega a otra página con el editor de planos en
  // fullscreen (portaled a <body>), restauramos el DOM y limpiamos las
  // clases del body para no romper la siguiente página (Dispositivos,
  // Dashboard, etc.).
  document.addEventListener('astro:before-swap', () => {
    const editorRoot = document.getElementById('bp-editor-root');
    const placeholder = document.getElementById('bp-fs-placeholder');
    if (editorRoot && editorRoot.classList.contains('bp-fs')) {
      editorRoot.classList.remove('bp-fs');
      if (placeholder && placeholder.parentNode) {
        placeholder.parentNode.insertBefore(editorRoot, placeholder);
        placeholder.remove();
      } else {
        // Sin placeholder: removemos el huérfano para que no quede pegado al body
        editorRoot.remove();
      }
    }
    document.body.classList.remove('bp-fs-body');
    // Si se sale con el editor de Apuntes a pantalla completa, la clase
    // dejaría el scroll bloqueado y el botón flotante oculto en la
    // siguiente página.
    document.body.classList.remove('ap-fullscreen');
    document.body.classList.remove('nw-app-mode');
    // Quitar el tema oscuro de Notas al salir hacia otra página
    document.documentElement.classList.remove('nw-dark');
  });

  // Cleanup defensivo al cargar páginas que no son /notas:
  // limpia huérfanos y clases de body que hayan podido quedar de sesiones previas.
  document.addEventListener('astro:page-load', () => {
    const path = window.location.pathname.replace(/\/$/, '');
    if (path === '/notas') return;
    document.body.classList.remove('bp-fs-body');
    const orphan = document.getElementById('bp-editor-root');
    if (orphan && orphan.parentElement === document.body) orphan.remove();
    const ph = document.getElementById('bp-fs-placeholder');
    if (ph) ph.remove();
  });
</script>

<style>
/* ════════════════════════════════════════════════════════
   NOTES WORKSPACE — Layout base
   ════════════════════════════════════════════════════════ */
.nw {
  display: flex;
  flex-direction: column;
  gap: 16px;
  height: calc(100vh - 130px);
  /* Importante: usar height (no min-height) para que el scroll interno
     funcione correctamente y la toolbar sticky se quede anclada. */
  animation: nwIn .4s cubic-bezier(0.4,0,0.2,1);
}
@keyframes nwIn { from { opacity:0; transform: translateY(10px); } to { opacity:1; transform:none; } }

/* ── Header ─────────────────────────────────────────────── */
.nw-head {
  position: relative;
  border-radius: 18px;
  padding: 22px 26px;
  display: flex; align-items: center; gap: 24px;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
  color: #fff;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(15,23,42,.18), 0 1px 0 rgba(255,255,255,.06) inset;
}
.nw-head::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 60% 80% at 18% 50%, rgba(59,130,246,.22), transparent 60%),
              radial-gradient(ellipse 50% 70% at 80% 30%, rgba(139,92,246,.18), transparent 55%);
  pointer-events: none;
}
.nw-head-bar {
  position: absolute; top:0; left:0; right:0; height:4px;
  background: linear-gradient(90deg,#3b82f6,#10b981,#8b5cf6,#f59e0b);
}
.nw-head-left { flex: 1; min-width: 0; position: relative; z-index: 1; }
.nw-eyebrow {
  font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px;
  text-transform: uppercase;
  color: rgba(255,255,255,.55); margin-bottom: 6px;
}
.nw-title {
  font-size: 26px; font-weight: 800;
  letter-spacing: -.6px; line-height: 1.15; margin: 0;
}
.nw-sub { font-size: 13px; color: rgba(255,255,255,.6); margin-top: 4px; }

.nw-head-right {
  display: flex; gap: 10px; flex-shrink: 0;
  position: relative; z-index: 1;
  align-items: center;
}

/* ── Toggle de tema oscuro/claro ─────────────────────────── */
.nw-theme-toggle {
  width: 38px; height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.12);
  color: #fff;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all .25s cubic-bezier(.34,1.4,.64,1);
  flex-shrink: 0;
}
.nw-theme-toggle:hover {
  background: rgba(255,255,255,.16);
  transform: scale(1.08) rotate(-12deg);
  box-shadow: 0 0 18px rgba(255,255,255,.25);
}
.nw-theme-toggle svg { width: 17px; height: 17px; }
.nw-tt-sun { display: none; }
.nw-stat {
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 12px;
  padding: 10px 14px;
  text-align: center;
  min-width: 70px;
  transition: transform .2s cubic-bezier(0.34,1.56,0.64,1);
}
.nw-stat:hover { transform: translateY(-3px); background: rgba(255,255,255,.1); }
.nw-stat-n {
  display: block;
  font-size: 22px; font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
  line-height: 1; color: #fff;
}
.nw-stat-l {
  display: block;
  font-size: 9.5px; font-weight: 600;
  text-transform: uppercase; letter-spacing: .4px;
  color: rgba(255,255,255,.5);
  margin-top: 4px;
}

/* ── Tabs tipo "wallet" ─────────────────────────────────── */
.nw-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
.nw-tab {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex; align-items: center; gap: 12px;
  cursor: pointer;
  text-align: left;
  position: relative;
  overflow: hidden;
  transition: transform .25s cubic-bezier(0.34,1.56,0.64,1), box-shadow .25s ease, border-color .25s ease;
  font-family: inherit;
}
.nw-tab::before {
  content: '';
  position: absolute; top:0; left:0; right:0; height:3px;
  background: var(--c);
  transform: scaleX(0); transform-origin: left;
  transition: transform .3s cubic-bezier(.4,0,.2,1);
}
.nw-tab:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0,0,0,.08);
  border-color: color-mix(in srgb, var(--c) 30%, var(--border));
}
.nw-tab.active {
  border-color: var(--c);
  background: color-mix(in srgb, var(--c) 6%, var(--surface));
  box-shadow: 0 8px 24px color-mix(in srgb, var(--c) 18%, transparent);
}
.nw-tab.active::before { transform: scaleX(1); }
.nw-tab-ico {
  width: 42px; height: 42px;
  border-radius: 11px;
  background: color-mix(in srgb, var(--c) 12%, transparent);
  color: var(--c);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: transform .25s ease;
}
.nw-tab:hover .nw-tab-ico { transform: scale(1.08) rotate(-4deg); }
.nw-tab-ico svg { width: 22px; height: 22px; }
.nw-tab-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.nw-tab-name {
  font-size: 14px; font-weight: 700;
  color: var(--text-main);
  letter-spacing: -.2px;
}
.nw-tab-desc {
  font-size: 11px; color: var(--text-muted); font-weight: 500;
}

/* ── Contenedor de sección ──────────────────────────────── */
.nw-content {
  flex: 1; min-height: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  position: relative;
}
.nw-loading {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 14px;
  color: var(--text-muted);
  font-size: 13px;
}
.nw-spinner {
  width: 32px; height: 32px;
  border: 3px solid var(--surface-3);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: nwSpin .8s linear infinite;
}
@keyframes nwSpin { to { transform: rotate(360deg); } }

/* ── Responsive ─────────────────────────────────────────── */
@media (max-width: 1024px) {
  .nw-head { flex-direction: column; align-items: flex-start; gap: 16px; }
  .nw-head-right { width: 100%; justify-content: space-between; }
  .nw-tabs { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  /* En mobile dejamos que la página scrollee naturalmente */
  .nw { height: auto; min-height: calc(100vh - 130px); }
  .nw-content { min-height: 70vh; }
}
@media (max-width: 600px) {
  .nw-head { padding: 18px; }
  .nw-title { font-size: 22px; }
  .nw-head-right { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .nw-tabs { grid-template-columns: 1fr; gap: 8px; }
  .nw-stat { min-width: unset; }
}

/* ════════════════════════════════════════════════════════
   ESTILOS GLOBALES COMPARTIDOS ENTRE SECCIONES (.nws-*)
   Inyectados aquí para que estén disponibles cuando los scripts
   monten el HTML dinámicamente.
   ════════════════════════════════════════════════════════ */

/* ── Layout interno de sección (split tipo Notion) ──────── */
:global(.nws) {
  flex: 1; display: flex; min-height: 0; width: 100%;
  animation: nwsFade .3s ease both;
}
@keyframes nwsFade { from { opacity:0 } to { opacity:1 } }

:global(.nws-side) {
  width: 280px; flex-shrink: 0;
  background: var(--surface-2);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
  min-height: 0;
}
:global(.nws-side-hdr) {
  padding: 14px 16px;
  display: flex; align-items: center; justify-content: space-between;
  gap: 8px;
  border-bottom: 1px solid var(--border);
}
:global(.nws-side-title) {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .5px; color: var(--text-muted);
}
:global(.nws-side-list) {
  flex: 1; min-height: 0; overflow-y: auto;
  padding: 8px;
  display: flex; flex-direction: column; gap: 2px;
}
:global(.nws-main) {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column;
  min-height: 0;
}
:global(.nws-main-hdr) {
  padding: 14px 22px;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  gap: 14px;
  flex-shrink: 0;
}
:global(.nws-main-body) {
  flex: 1; min-height: 0; overflow-y: auto;
  padding: 22px;
}

/* ── Botones compartidos ────────────────────────────────── */
:global(.nws-btn) {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 9px;
  font-size: 12.5px; font-weight: 600;
  color: var(--text-main);
  cursor: pointer;
  transition: all .18s ease;
  font-family: inherit;
}
:global(.nws-btn:hover) { background: var(--surface-3); border-color: color-mix(in srgb, var(--primary) 30%, var(--border)); }
:global(.nws-btn.primary) {
  background: var(--primary); color: #fff; border-color: var(--primary);
}
:global(.nws-btn.primary:hover) { background: var(--primary-hover); border-color: var(--primary-hover); }
:global(.nws-btn.danger:hover) {
  background: color-mix(in srgb, var(--danger) 15%, var(--surface));
  border-color: var(--danger);
  color: var(--danger);
}
:global(.nws-btn svg) { width: 14px; height: 14px; }
:global(.nws-iconbtn) {
  width: 32px; height: 32px;
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 9px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-muted);
  transition: all .15s ease;
}
:global(.nws-iconbtn:hover) { background: var(--surface-3); color: var(--text-main); }
:global(.nws-iconbtn svg) { width: 15px; height: 15px; }

/* ── Search input ───────────────────────────────────────── */
:global(.nws-search) {
  display: flex; align-items: center; gap: 6px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 6px 10px;
  flex: 1;
  transition: border-color .18s ease;
}
:global(.nws-search:focus-within) {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent);
}
:global(.nws-search svg) { width: 14px; height: 14px; color: var(--text-muted); flex-shrink: 0; }
:global(.nws-search input) {
  border: none; outline: none; background: transparent;
  font-size: 12.5px; flex: 1; color: var(--text-main);
  font-family: inherit;
}

/* ── Estado vacío ───────────────────────────────────────── */
:global(.nws-empty) {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 12px; padding: 40px 20px;
  text-align: center;
  color: var(--text-muted);
}
:global(.nws-empty-ico) {
  width: 60px; height: 60px;
  border-radius: 50%;
  background: var(--surface-3);
  display: flex; align-items: center; justify-content: center;
  color: var(--text-muted);
}
:global(.nws-empty-ico svg) { width: 28px; height: 28px; }
:global(.nws-empty-title) {
  font-size: 15px; font-weight: 700; color: var(--text-main);
}
:global(.nws-empty-sub) {
  font-size: 12.5px;
  max-width: 320px;
  line-height: 1.5;
}

/* ── Chips/tags ─────────────────────────────────────────── */
:global(.nws-tag) {
  display: inline-block;
  padding: 2px 8px;
  font-size: 10.5px; font-weight: 600;
  background: var(--surface-3);
  color: var(--text-muted);
  border-radius: 6px;
  margin-right: 4px;
}

/* ── Mobile responsive del split ────────────────────────── */
@media (max-width: 900px) {
  :global(.nws) { flex-direction: column; }
  :global(.nws-side) {
    width: 100%; max-height: 35vh;
    border-right: none; border-bottom: 1px solid var(--border);
  }
}

/* Ocultos en escritorio: solo existen en el modo app del teléfono */
.nw-back { display: none; }
.nw-fab  { display: none; }

/* ════════════════════════════════════════════════════════
   MODO APP (teléfono)
   Notas deja de ser una página del panel y pasa a ocupar la
   pantalla entera, con barra superior propia, navegación
   inferior y botón flotante de crear. Al entrar se siente
   como abrir otra aplicación; se sale con la flecha.
   Nada de esto aplica en escritorio.
   ════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  /* El contenedor se despega del panel y tapa barra superior,
     menú lateral y botón flotante de navegación, que quedan por
     debajo en la escala de capas. */
  .nw {
    position: fixed;
    inset: 0;
    z-index: var(--z-sheet);
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    gap: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }

  /* ── Barra superior de la app ── */
  .nw-head {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 0;
    flex-shrink: 0;
  }
  .nw-head-bar { display: none; }
  .nw-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    color: inherit;
    text-decoration: none;
  }
  .nw-back svg { width: 20px; height: 20px; }
  .nw-head-left { flex: 1; min-width: 0; }
  /* En una barra de app sobra todo menos el nombre */
  .nw-eyebrow, .nw-sub { display: none; }
  .nw-title { font-size: 17px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nw-head-right { width: auto; display: flex; gap: 6px; }
  /* Los contadores pasan a la navegación inferior */
  .nw-stat { display: none; }

  /* ── Contenido ── */
  .nw-content {
    flex: 1;
    min-height: 0;
    margin: 0;
    border: none;
    border-radius: 0;
    background: var(--surface);
  }

  /* ── Navegación inferior ── */
  .nw-tabs {
    display: flex;
    gap: 0;
    order: 99;             /* siempre al final, sea cual sea el orden del DOM */
    flex-shrink: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .nw-tab {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 9px 4px 7px;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    min-width: 0;
  }
  .nw-tab-ico { width: 23px; height: 23px; margin: 0; }
  .nw-tab-ico svg { width: 20px; height: 20px; }
  .nw-tab-body { align-items: center; }
  .nw-tab-name { font-size: 11px; font-weight: 600; }
  /* La descripción no cabe y tampoco hace falta con el icono */
  .nw-tab-desc { display: none; }
  .nw-tab.active { background: transparent; color: var(--c); }
  .nw-tab.active .nw-tab-ico,
  .nw-tab.active .nw-tab-name { color: var(--c); }

  /* ── Botón flotante de crear ── */
  .nw-fab {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    right: 18px;
    bottom: calc(76px + env(safe-area-inset-bottom, 0px));
    width: 56px; height: 56px;
    border: none;
    border-radius: 50%;
    background: var(--primary);
    color: var(--white);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--primary) 45%, transparent);
    cursor: pointer;
    z-index: 5;
  }
  .nw-fab svg { width: 26px; height: 26px; }
  .nw-fab:active { transform: scale(.94); }

  /* ── Escribiendo una nota: inmersión total ──
     Con el editor a pantalla completa, la barra de la app y la
     navegación inferior quedaban detrás y su titulo se cruzaba con el
     de la nota. Se retiran mientras se escribe, igual que en una app
     de notas; se recuperan al cerrar con la X. */
  body.ap-fullscreen .nw-head,
  body.ap-fullscreen .nw-tabs,
  body.ap-fullscreen .nw-fab { display: none; }

  /* Planos no se ofrece en teléfono: el editor de dibujo necesita
     lienzo y precisión de puntero que una pantalla pequeña no da. */
  .nw-tab[data-section="planos"] { display: none; }
}

/* ════════════════════════════════════════════════════════
   SECCIONES EN TELÉFONO
   El panel lateral de categorías ocupaba hasta un 35% del alto para
   mostrar una lista corta. Aquí pasa a ser una tira horizontal de
   pastillas, y el contenido se queda con el resto de la pantalla.

   Apuntes queda fuera (:not) porque tiene DOS paneles laterales
   —carpetas y lista de notas— y su propio flujo por niveles.
   ════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  :global(.nws:not(.nws-apuntes) > .nws-side) {
    width: 100%;
    max-height: none;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
  :global(.nws:not(.nws-apuntes) > .nws-side > .nws-side-hdr) {
    border-bottom: none;
    border-right: 1px solid var(--border);
    padding: 8px 12px;
    flex-shrink: 0;
  }
  :global(.nws:not(.nws-apuntes) > .nws-side > .nws-side-list) {
    flex-direction: row;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 6px;
    padding: 8px 10px;
  }
  :global(.nws:not(.nws-apuntes) > .nws-side > .nws-side-list > *) {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Buscador y botón de crear, en su propia fila y a lo ancho */
  :global(.nws-main-hdr) { flex-wrap: wrap; padding: 12px 14px; gap: 10px; }
  :global(.nws-main-hdr .nws-search) { flex: 1; min-width: 0; }
  :global(.nws-main-body) { padding: 14px; }

  /* La rejilla de la Bóveda pedía un mínimo de 320px por tarjeta, que en
     pantallas de 320–360px se desborda. Aquí siempre una columna. */
  :global(.vt-grid) { grid-template-columns: 1fr; }

  /* Hueco al final de las listas para que el botón flotante no tape
     el último elemento. */
  :global(.nws-main-body) { padding-bottom: 86px; }
  :global(.nws-apuntes .ap-notes-side .nws-side-list) { padding-bottom: 86px; }
}
