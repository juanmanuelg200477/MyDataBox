---
import { icons } from '../scripts/icons.js';
---
<div class="view-transition">
    <div class="page-header">
        <h1>Bastidores</h1>
        <div class="page-header-actions">
            <button class="btn btn-primary" id="btn-add-rack" set:html={icons.plus + ' Añadir'}></button>
        </div>
    </div>
    <div class="card">
        <div class="card-header" style="flex-wrap:wrap;row-gap:10px;">
            <h2>Resultados <span id="racks-count" style="background:var(--primary);color:#fff;padding:1px 8px;border-radius:10px;font-size:11px;margin-left:6px">0</span></h2>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <div class="search-box">
                    <span set:html={icons.search}></span>
                    <input type="text" placeholder="Buscar bastidor..." id="search-racks">
                </div>
                <select id="rack-region-filter" class="dev-filter-select">
                    <option value="">Todas las regiones</option>
                </select>
                <select id="rack-status-filter" class="dev-filter-select">
                    <option value="">Cualquier estado</option>
                    <option value="Activo">Activo</option>
                    <option value="En Reposo">En Reposo</option>
                </select>
            </div>
        </div>
        <div class="db-loading" id="racks-loading">
            <div class="db-spinner"></div>
            <span>Cargando bastidores…</span>
        </div>
        <div id="racks-table-container" style="display:none">
            <table class="table-cards">
                <thead><tr><th>#</th><th>Nombre</th><th>Región</th><th>Área</th><th>Estado</th><th>Tipo</th><th>Altura</th><th>Dispositivos</th><th>Espacio</th><th>Acciones</th></tr></thead>
                <tbody id="racks-tbody"></tbody>
            </table>
            <div class="table-count" id="racks-showing-count">Mostrando 0 de 0</div>
            <div class="pager" id="racks-pager" style="display:none"></div>
        </div>
        <div id="racks-empty-state" class="empty-state" style="display:none">
            <div set:html={icons.rack}></div>
            <p>No hay bastidores creados</p><small>Crea regiones y áreas, luego añade bastidores</small>
        </div>
    </div>
</div>
<style>
.dev-filter-select {
    padding: 8px 11px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    font-size: 12.5px;
    font-family: inherit;
    background: var(--bg);
    color: var(--text);
    transition: var(--transition);
    cursor: pointer;
}
.dev-filter-select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
}
</style>

<script>
    import { load } from '../scripts/store.js';
    import { initRacks } from '../scripts/views/racks.js';
    document.addEventListener('astro:page-load', async () => {
        // Guard de ruta: el listener vive en document y se dispara en TODA
        // navegación posterior, así que sin esto cada módulo ya visitado
        // recargaba las 8 tablas del store en cada cambio de página.
        if (window.location.pathname.replace(/\/$/, '') !== '/bastidores') return;
        await load();
        document.getElementById('racks-loading')?.remove();
        initRacks();
    });
</script>
