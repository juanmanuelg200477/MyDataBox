---
import '../styles/fonts.css';
import '../styles/login.css';

// src/pages/login.astro
//
// Las ramas se declaran UNA sola vez aquí y la lista del selector se pinta
// desde el servidor. El guion del cliente las vuelve a leer de los atributos
// data-* del propio menú, así que no hay una segunda copia que se pueda
// desincronizar.
//
//   ready:false  → la rama todavía no existe; se avisa y no se intenta entrar.
//   home         → a dónde va el usuario cuando la rama sí está lista.
const BRANCHES = [
    {
        id: 'infrastructure',
        label: 'Infrastructure',
        desc: 'Regiones, bastidores y dispositivos',
        color: '#3b82f6',
        ready: true,
        home: '/'
    },
    {
        id: 'support',
        label: 'Support',
        desc: 'Mesa de ayuda y tickets',
        color: '#f59e0b',
        ready: false,
        home: '/support'
    },
    {
        id: 'servers',
        label: 'Servers',
        desc: 'Servidores y servicios',
        color: '#a855f7',
        ready: false,
        home: '/servers'
    }
];
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Login — DataBox IT</title>
</head>
<body>

    <div class="lg-shell">

        <!-- ══ Identidad + animación ══════════════════════════════ -->
        <aside class="lg-brand">
            <div id="threads-container"></div>

            <div class="lg-brand-inner">
                <div class="lg-logo-row">
                    <svg class="atom-logo-login" viewBox="0 0 48 48" width="42" height="42" fill="none" xmlns="http://www.w3.org/2000/svg" style="animation:atomSpinLogin 10s linear infinite;filter:drop-shadow(0 0 7px rgba(203,213,225,0.45));">
                        <defs>
                            <linearGradient id="atom-orbit-lg" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#e2e8f0" stop-opacity="0.9"/>
                                <stop offset="50%" stop-color="#f8fafc" stop-opacity="0.7"/>
                                <stop offset="100%" stop-color="#cbd5e1" stop-opacity="0.9"/>
                            </linearGradient>
                            <radialGradient id="atom-core-lg" cx="50%" cy="40%" r="50%">
                                <stop offset="0%" stop-color="#ffffff"/>
                                <stop offset="50%" stop-color="#e2e8f0"/>
                                <stop offset="100%" stop-color="#94a3b8"/>
                            </radialGradient>
                        </defs>
                        <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-lg)" stroke-width="1.3" transform="rotate(0 24 24)"/>
                        <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-lg)" stroke-width="1.3" transform="rotate(60 24 24)"/>
                        <ellipse cx="24" cy="24" rx="20" ry="8" stroke="url(#atom-orbit-lg)" stroke-width="1.3" transform="rotate(-60 24 24)"/>
                        <circle cx="24" cy="24" r="4.5" fill="url(#atom-core-lg)"/>
                        <circle cx="24" cy="24" r="3" fill="#f1f5f9" opacity="0.5"/>
                    </svg>
                    <h1 class="lg-title">DataBox IT</h1>
                </div>

                <div class="lg-branch-line">
                    <span class="lg-branch-pulse" id="branch-pulse"></span>
                    <p id="branch-name">Branch Module</p>
                </div>

                <p id="branch-desc">Elige una rama para continuar.</p>

                <div class="lg-rule"></div>
                <div class="lg-foot">Cooperativa Integral de Producción Madre y Maestra, R.L.</div>
            </div>
        </aside>

        <!-- ══ Acceso ═════════════════════════════════════════════ -->
        <main class="lg-access">
            <div class="lg-orb lg-orb-a"></div>
            <div class="lg-orb lg-orb-b"></div>

            <section class="lg-card" id="login-card">
                <div class="lg-card-head">
                    <h2>Bienvenido</h2>
                    <p>Selecciona tu rama e inicia sesión.</p>
                </div>

                <!-- Selector de rama: va antes de las credenciales porque
                     elegir rama es el primer paso obligatorio. -->
                <div class="lg-branch-picker" id="branch-picker">
                    <button type="button" class="lg-branch-btn" id="branch-btn"
                            aria-haspopup="listbox" aria-expanded="false" aria-controls="branch-menu">
                        <span class="lg-branch-dot"></span>
                        <span id="branch-btn-label">Branch</span>
                        <svg class="lg-branch-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>

                    <ul class="lg-branch-menu" id="branch-menu" role="listbox" aria-label="Ramas disponibles" hidden>
                        {BRANCHES.map(b => (
                            <li role="presentation">
                                <button type="button" class="lg-branch-opt" role="option"
                                        aria-selected="false"
                                        data-id={b.id}
                                        data-label={b.label}
                                        data-desc={b.desc}
                                        data-color={b.color}
                                        data-ready={String(b.ready)}
                                        data-home={b.home}
                                        style={`--branch-color:${b.color}`}>
                                    <span class="lg-opt-dot"></span>
                                    <span class="lg-opt-txt">
                                        <span class="lg-opt-name">{b.label}</span>
                                        <span class="lg-opt-desc">{b.desc}</span>
                                    </span>
                                    <span class={`lg-opt-tag ${b.ready ? 'on' : 'off'}`}>
                                        {b.ready ? 'Disponible' : 'En proceso'}
                                    </span>
                                </button>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="form-group">
                    <label for="username">Correo electrónico</label>
                    <input type="email" id="username" placeholder="correo@ejemplo.com" autocomplete="email" />
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <div class="pwd-wrap">
                        <input type="password" id="password" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="pwd-toggle" id="pwd-toggle"
                                aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
                            <svg class="pwd-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg class="pwd-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="login-error" id="login-error"></div>

                <button class="btn-login" id="login-btn">Ingresar</button>
            </section>
        </main>
    </div>

    <div class="lg-toasts" id="lg-toasts" aria-live="polite" aria-atomic="false"></div>

    <script>
        // Selección de rama y autenticación: scripts/login/acceso.js
        import '../scripts/login/acceso.js';
    </script>

    <script>
        // Reflejo de la tarjeta siguiendo al cursor
        document.addEventListener('DOMContentLoaded', () => {
            const card = document.getElementById('login-card');
            if (!card) return;

            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
                card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
            });
        });
    </script>

    <script>
        // Fondo animado: scripts/login/fondo.js
        import '../scripts/login/fondo.js';
    </script>
</body>
</html>
