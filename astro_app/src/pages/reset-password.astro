---
<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>Nueva contraseña — DataBox IT</title>
    <style>
        body { margin:0; display:flex; align-items:center; justify-content:center; min-height:100vh;
               font-family:'DM Sans',sans-serif; background:#0D0716; color:#fff; }
        .card { background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1);
                padding:40px; border-radius:20px; width:340px; display:flex; flex-direction:column; gap:20px; }
        h2 { margin:0; font-size:22px; font-weight:700; }
        label { font-size:12px; font-weight:600; color:rgba(255,255,255,0.6); text-transform:uppercase; letter-spacing:.5px; }
        input { background:rgba(0,0,0,0.4); border:1px solid rgba(255,255,255,0.1); padding:12px 16px;
                border-radius:10px; color:#fff; font-size:15px; width:100%; box-sizing:border-box; }
        input:focus { outline:none; border-color:rgba(59,130,246,0.6); }
        button { background:linear-gradient(135deg,#3b82f6,#2563eb); color:#fff; border:none;
                 padding:14px; border-radius:10px; font-size:15px; font-weight:700; cursor:pointer; }
        .msg { font-size:13px; text-align:center; min-height:18px; }
        .err { color:#f87171; } .ok { color:#4ade80; }
    </style>
</head>
<body>
    <div class="card">
        <h2>🔑 Nueva contraseña</h2>
        <div style="display:flex;flex-direction:column;gap:8px;">
            <label>Nueva contraseña</label>
            <input type="password" id="pass1" placeholder="Mínimo 6 caracteres" />
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;">
            <label>Confirmar contraseña</label>
            <input type="password" id="pass2" placeholder="Repite la contraseña" />
        </div>
        <div class="msg" id="msg"></div>
        <button id="btn">Guardar nueva contraseña</button>
    </div>

    <script>
        import { supabase } from '../scripts/supabase.js';

        // Supabase maneja el token del hash automáticamente al cargar
        document.getElementById('btn').addEventListener('click', async () => {
            const p1 = document.getElementById('pass1').value;
            const p2 = document.getElementById('pass2').value;
            const msg = document.getElementById('msg');

            if (!p1 || p1.length < 6) { msg.className='msg err'; msg.textContent='Mínimo 6 caracteres.'; return; }
            if (p1 !== p2) { msg.className='msg err'; msg.textContent='Las contraseñas no coinciden.'; return; }

            const { error } = await supabase.auth.updateUser({ password: p1 });

            if (error) {
                msg.className='msg err';
                msg.textContent = 'Error: ' + error.message;
            } else {
                msg.className='msg ok';
                msg.textContent = '¡Contraseña actualizada! Redirigiendo...';
                setTimeout(() => window.location.href = '/', 2000);
            }
        });
    </script>
</body>
</html>
